---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { nodes, getNodeBySlug } from "../../data/nodos";
import { getNodeTraces } from "../../lib/trazas";
import NodeYouTubeFeed from "../../components/NodeYouTubeFeed.astro";
import { formatShortDate } from "../../lib/editorial";

export function getStaticPaths() {
  return nodes.map((node) => ({
    params: { slug: node.slug },
  }));
}

const { slug } = Astro.params;
const node = getNodeBySlug(slug ?? "");

if (!node) {
  return Astro.redirect("/");
}

const traces = await getNodeTraces(node);
---

<BaseLayout
  title={`${node.name} | Crítica Acelerada`}
  description={`Registro nodal de ${node.name} en Crítica Acelerada.`}
  lang="es"
  type="profile"
  author={node.name}
>
  <main class="node-profile">
    <section class="node-hero">
      <div class="container">
        <nav class="case-breadcrumb" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <span>Micelio</span>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{node.code}</span>
        </nav>

        <div class="node-hero-layout">
          <aside class="node-aside">
            <span class="node-code">{node.code}</span>
            <span class="node-role">{node.role}</span>
            <div class="node-line" aria-hidden="true"></div>
            <span class="node-status">{node.status}</span>
            {node.location && (
              <span class="node-location">{node.location}</span>
            )}
          </aside>

          <div class="node-heading">
            <span class="eyebrow">REGISTRO NODAL</span>
            <h1>{node.name}</h1>

            <div class="field-list">
              {node.fields.map((field) => <span>{field}</span>)}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="profile-section">
      <div class="container profile-layout">
        <aside class="section-aside">
          <span>01</span>
          <strong>TRAYECTORIA</strong>
        </aside>

        <div class="profile-copy">
          <span class="profile-label">TRABAJO PROFESIONAL</span>
          <p>{node.professional}</p>
        </div>
      </div>
    </section>

    {
      node.parallel && (
        <section class="profile-section">
          <div class="container profile-layout">
            <aside class="section-aside">
              <span>02</span>
              <strong>PRÁCTICA PARALELA</strong>
            </aside>

            <div class="profile-copy">
              <span class="profile-label">{node.parallel.title}</span>
              <p>{node.parallel.description}</p>

              {node.parallel.url && (
                <a
                  class="external-link"
                  href={node.parallel.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {node.parallel.label ?? "VISITAR PROYECTO"}
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </div>
        </section>
      )
    }

    {
      node.youtube && (
        <section class="profile-section">
          <div class="container profile-layout">
            <aside class="section-aside">
              <span>03</span>
              <strong>ACTIVIDAD EXTERNA</strong>
            </aside>

            <div class="profile-copy">
              <span class="profile-label">CORRIENTE DEL NODO</span>
              <p>
                Publicaciones recientes del canal de YouTube asociado a este
                nodo. Una ventana hacia su práctica externa y hacia los proyectos
                que orbitan alrededor del nodo.
              </p>

              <NodeYouTubeFeed
                handle={node.youtube.handle}
                label={node.youtube.label}
                url={node.youtube.url}
              />
            </div>
          </div>
        </section>
      )
    }

    <section class="profile-section traces-section">
      <div class="container profile-layout">
        <aside class="section-aside">
          <span>{node.youtube ? "04" : "03"}</span>
          <strong>TRAZAS EN CA</strong>
        </aside>

        <div class="profile-copy">
          <div class="traces-heading">
            <span class="profile-label">REGISTRO DE CONTRIBUCIONES</span>
            <span class="traces-count">
              {String(traces.length).padStart(2, "0")} TRAZAS
            </span>
          </div>

          {
            traces.length > 0 ? (
              <div class="trace-list">
                {traces.map((trace) => (
                  <a class="trace-row" href={trace.href}>
                    <div class="trace-meta">
                      <span class="trace-code">{trace.code}</span>
                      <span>{trace.type}</span>
                      <time datetime={trace.date.toISOString().slice(0, 10)}>
                        {formatShortDate(trace.date)}
                      </time>
                    </div>

                    <div class="trace-main">
                      <span class="trace-role">{trace.role}</span>
                      <h3>{trace.title}</h3>
                    </div>

                    <span class="trace-arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                ))}
              </div>
            ) : (
              <div class="trace-empty">
                <span>CA / SISTEMA</span>
                <strong>SIN TRAZAS REGISTRADAS</strong>
                <small>
                  Este nodo todavía no aparece en los metadatos de los archivos
                  sincronizados.
                </small>
              </div>
            )
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .node-profile {
    background: var(--bg);
    color: var(--text);
  }

  .node-hero {
    padding: 2.25rem 0 4rem;
    border-bottom: 1px solid var(--border);
  }

  .node-hero-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
    padding-top: 1.75rem;
    border-top: 2px solid var(--accent);
  }

  .node-aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .node-code {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--accent-text);
  }

  .node-role,
  .node-location {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .node-line {
    width: 36px;
    height: 2px;
    margin: 0.5rem 0;
    background: var(--accent);
  }

  .node-status {
    position: relative;
    padding-left: 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--text);
  }

  .node-status::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 6px;
    height: 6px;
    transform: translateY(-50%);
    border-radius: 50%;
    background: var(--accent);
  }

  .node-heading h1 {
    margin: 0.75rem 0 1.5rem;
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 5vw, 3.85rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--text);
  }

  .field-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .field-list span {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
  }

  .profile-section {
    padding: 3.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .profile-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
  }

  .section-aside {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .section-aside span {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }

  .section-aside strong {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .profile-copy {
    min-width: 0;
    max-width: 68ch;
  }

  .traces-section .profile-copy {
    max-width: none;
  }

  .profile-label {
    display: block;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--accent-text);
  }

  .profile-copy p {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.78;
    color: var(--text-body);
  }

  .external-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--accent-text);
    border-bottom: 1px solid var(--accent);
    transition: color 0.2s ease;
  }

  .external-link:hover {
    color: var(--text);
  }

  .traces-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .traces-heading .profile-label {
    margin-bottom: 0;
  }

  .traces-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--meta);
    font-variant-numeric: tabular-nums;
  }

  .trace-list {
    border-top: 2px solid var(--accent);
  }

  .trace-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.65rem 1.5rem;
    align-items: center;
    padding: 1.45rem 0;
    border-bottom: 1px solid var(--border);
    transition: background-color 0.2s ease, padding-left 0.2s ease;
  }

  .trace-row:hover {
    background: var(--surface);
    padding-left: 0.75rem;
  }

  .trace-meta {
    grid-column: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: var(--meta);
    font-variant-numeric: tabular-nums;
  }

  .trace-code {
    color: var(--accent-text);
  }

  .trace-main {
    grid-column: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .trace-role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .trace-main h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: 600;
    line-height: 1.22;
    color: var(--text);
  }

  .trace-row:hover .trace-main h3 {
    color: var(--accent-text);
  }

  .trace-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-size: 1.15rem;
    color: var(--accent-text);
    transition: transform 0.2s ease;
  }

  .trace-row:hover .trace-arrow {
    transform: translateX(4px);
  }

  .trace-empty {
    padding: 2rem;
    border: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .trace-empty span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--accent-text);
  }

  .trace-empty strong {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--text);
  }

  .trace-empty small {
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 860px) {
    .node-hero-layout,
    .profile-layout {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .profile-section {
      padding: 2.75rem 0;
    }
  }
</style>
