---

import "../../styles/global.css";

import SocialFooter from "../../components/SocialFooter.astro";

import { nodes, getNodeBySlug } from "../../data/nodos";

import { getNodeTraces } from "../../lib/trazas";

import NodeYouTubeFeed from "../../components/NodeYouTubeFeed.astro";

export function getStaticPaths() {

    return nodes.map((node) => ({

        params: { slug: node.slug },

    }));

}

const { slug } = Astro.params;

const node = getNodeBySlug(slug ?? "");

if (!node) {

    return Astro.redirect("/");

}

const traces = await getNodeTraces(node);

const formatearFecha = (fecha: Date) =>

    new Intl.DateTimeFormat("es-MX", {

        day: "2-digit",

        month: "2-digit",

        year: "numeric",

    })

        .format(fecha)

        .replaceAll("/", ".");

---

<!doctype html>

<html lang="es">

<head>

    <meta charset="UTF-8" />

    <meta

        name="viewport"

        content="width=device-width, initial-scale=1.0"

    />

    <meta

        name="description"

        content={`Registro nodal de ${node.name} en Crítica Acelerada.`}

    />

    <meta

        name="theme-color"

        content="#050505"

    />

    <title>{node.name} — Crítica Acelerada</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

</head>

<body>

    <main class="node-profile">

        <section class="node-hero">

            <div class="node-grid-background" aria-hidden="true"></div>

            <div class="node-ghost" aria-hidden="true">

                {node.code.endsWith("001") ? "01" : "02"}

            </div>

            <div class="profile-container">

                <a class="back-link" href="/">

                    <span>←</span>

                    VOLVER AL LABORATORIO

                </a>

                <div class="node-hero-layout">

                    <aside class="node-aside">

                        <span class="node-code">

                            {node.code}

                        </span>

                        <span class="node-role">

                            {node.role}

                        </span>

                        <div class="node-line"></div>

                        <span class="node-status">

                            {node.status}

                        </span>

                        {node.location && (

                            <span class="node-location">

                                {node.location}

                            </span>

                        )}

                    </aside>



                    <div class="node-heading">

                        <span class="section-eyebrow">

                            REGISTRO NODAL

                        </span>

                        <h1>

                            {node.name}

                        </h1>

                        <div class="field-list">

                            {node.fields.map((field) => (

                                <span>{field}</span>

                            ))}

                        </div>

                    </div>

                </div>

            </div>

        </section>



        <section class="profile-section">

            <div class="profile-container profile-layout">

                <aside class="section-aside">

                    <span>01</span>

                    <strong>TRAYECTORIA</strong>

                </aside>

                <div class="profile-copy">

                    <span class="profile-label">

                        TRABAJO PROFESIONAL

                    </span>

                    <p>

                        {node.professional}

                    </p>

                </div>

            </div>

        </section>



        {node.parallel && (

            <section class="profile-section parallel-section">

                <div class="profile-container profile-layout">

                    <aside class="section-aside">

                        <span>02</span>

                        <strong>PRÁCTICA PARALELA</strong>

                    </aside>

                    <div class="profile-copy">

                        <span class="profile-label">

                            {node.parallel.title}

                        </span>

                        <p>

                            {node.parallel.description}

                        </p>

                        {node.parallel.url && (

                            <a

                                class="external-link"

                                href={node.parallel.url}

                                target="_blank"

                                rel="noreferrer"

                            >

                                {node.parallel.label ?? "VISITAR PROYECTO"}

                                <span>↗</span>

                            </a>

                        )}

                    </div>

                </div>

            </section>

        )}



        {node.youtube && (

            <section class="profile-section parallel-section">

                <div class="profile-container profile-layout">

                    <aside class="section-aside">

                        <span>03</span>

                        <strong>ACTIVIDAD EXTERNA</strong>

                    </aside>

                    <div class="profile-copy">

                        <span class="profile-label">

                            CORRIENTE DEL NODO

                        </span>

                        <p>

                            Publicaciones recientes del canal de YouTube

                            asociado a este nodo. Este flujo pertenece a su

                            práctica externa y no constituye una traza interna

                            de Crítica Acelerada.

                        </p>

                        <NodeYouTubeFeed

                            handle={node.youtube.handle}

                            label={node.youtube.label}

                            url={node.youtube.url}

                        />

                    </div>

                </div>

            </section>

        )}



        <section class="profile-section traces-section">

            <div class="profile-container profile-layout">

                <aside class="section-aside">

                    <span>

                        {node.youtube ? "04" : "03"}

                    </span>

                    <strong>TRAZAS EN CA</strong>

                </aside>

                <div class="profile-copy">

                    <div class="traces-heading">

                        <span class="profile-label">

                            REGISTRO DE CONTRIBUCIONES

                        </span>

                        <span class="traces-count">

                            {String(traces.length).padStart(2, "0")} TRAZAS

                        </span>

                    </div>



                    {

                        traces.length > 0 ? (

                            <div class="trace-list">

                                {traces.map((trace) => (

                                    <a

                                        class="trace-row"

                                        href={trace.href}

                                    >

                                        <div class="trace-meta">

                                            <span class="trace-code">

                                                {trace.code}

                                            </span>

                                            <span>

                                                {trace.type}

                                            </span>

                                            <span>

                                                {formatearFecha(trace.date)}

                                            </span>

                                        </div>



                                        <div class="trace-main">

                                            <span class="trace-role">

                                                {trace.role}

                                            </span>

                                            <h3>

                                                {trace.title}

                                            </h3>

                                        </div>



                                        <span class="trace-arrow">

                                            →

                                        </span>

                                    </a>

                                ))}

                            </div>

                        ) : (

                            <div class="trace-empty">

                                <span>

                                    CA / SISTEMA

                                </span>

                                <strong>

                                    SIN TRAZAS REGISTRADAS

                                </strong>

                                <small>

                                    Este nodo todavía no aparece en los

                                    metadatos de los archivos sincronizados.

                                </small>

                            </div>

                        )

                    }

                </div>

            </div>

        </section>

    </main>

    <SocialFooter />

</body>

</html>



<style>

    .node-profile {

        --ca-black: #050505;

        --ca-black-deep: #020202;

        --ca-surface: #0a0a0a;

        --ca-white: #f5f5f5;

        --ca-grey: rgba(245, 245, 245, 0.56);

        --ca-muted: rgba(245, 245, 245, 0.28);

        --ca-line: rgba(245, 245, 245, 0.12);

        --ca-pink: #ff2f6d;

        min-height: 100vh;

        background: var(--ca-black);

        color: var(--ca-white);

        overflow: hidden;

    }



    .profile-container {

        width: min(

            1200px,

            calc(100% - 80px)

        );

        margin-inline: auto;

    }



    /* HERO */

    .node-hero {

        position: relative;

        min-height: 650px;

        padding: 52px 0 105px;

        overflow: hidden;

        isolation: isolate;

        border-bottom:

            1px solid var(--ca-line);

        background:

            radial-gradient(

                circle at 74% 40%,

                rgba(255, 47, 109, 0.06),

                transparent 37%

            ),

            linear-gradient(

                90deg,

                rgba(255, 47, 109, 0.02),

                transparent 45%

            ),

            #030303;

    }



    .node-grid-background {

        position: absolute;

        inset: 0;

        z-index: -2;

        opacity: 0.52;

        background-image:

            linear-gradient(

                rgba(255, 255, 255, 0.014) 1px,

                transparent 1px

            ),

            linear-gradient(

                90deg,

                rgba(255, 255, 255, 0.014) 1px,

                transparent 1px

            );

        background-size: 42px 42px;

        -webkit-mask-image:

            radial-gradient(

                ellipse at 65% 50%,

                black,

                transparent 78%

            );

        mask-image:

            radial-gradient(

                ellipse at 65% 50%,

                black,

                transparent 78%

            );

    }



    .node-ghost {

        position: absolute;

        right: 2%;

        top: 50%;

        z-index: -1;

        transform: translateY(-48%);

        font-size: clamp(

            230px,

            29vw,

            440px

        );

        font-weight: 700;

        line-height: 1;

        letter-spacing: -0.1em;

        color: rgba(255, 255, 255, 0.018);

        user-select: none;

    }



    .back-link {

        display: inline-flex;

        align-items: center;

        gap: 13px;

        margin-bottom: 95px;

        font-size: 8px;

        line-height: 1.5;

        letter-spacing: 0.22em;

        color: rgba(245, 245, 245, 0.38);

        text-decoration: none;

        transition:

            color 0.25s ease;

    }



    .back-link span {

        color: var(--ca-pink);

    }



    .back-link:hover {

        color: var(--ca-white);

    }



    .node-hero-layout {

        display: grid;

        grid-template-columns:

            185px

            minmax(0, 1fr);

        gap: 70px;

        align-items: start;

    }



    .node-aside {

        display: flex;

        flex-direction: column;

        gap: 13px;

        padding-top: 10px;

    }



    .node-code {

        font-size: 9px;

        line-height: 1.5;

        letter-spacing: 0.27em;

        color: var(--ca-pink);

    }



    .node-role,

    .node-location {

        font-size: 7px;

        line-height: 1.7;

        letter-spacing: 0.20em;

        color: rgba(245, 245, 245, 0.28);

    }



    .node-line {

        width: 78px;

        height: 1px;

        margin: 5px 0;

        background:

            linear-gradient(

                90deg,

                var(--ca-pink),

                transparent

            );

    }



    .node-status {

        position: relative;

        width: fit-content;

        padding-left: 12px;

        font-size: 7px;

        line-height: 1.5;

        letter-spacing: 0.20em;

        color: rgba(245, 245, 245, 0.25);

    }



    .node-status::before {

        content: "";

        position: absolute;

        left: 0;

        top: 50%;

        width: 4px;

        height: 4px;

        transform: translateY(-50%);

        border-radius: 50%;

        background: var(--ca-pink);

        box-shadow:

            0 0 8px rgba(255, 47, 109, 0.65);

    }



    .section-eyebrow {

        display: block;

        margin-bottom: 20px;

        font-size: 9px;

        line-height: 1.5;

        letter-spacing: 0.28em;

        color: var(--ca-pink);

    }



    .node-heading h1 {

        max-width: 920px;

        margin: 0;

        font-size: clamp(

            62px,

            8vw,

            122px

        );

        font-weight: 760;

        line-height: 0.84;

        letter-spacing: -0.075em;

        color: var(--ca-white);

        text-wrap: balance;

    }



    .field-list {

        display: flex;

        align-items: center;

        flex-wrap: wrap;

        gap: 12px 30px;

        margin-top: 45px;

        font-size: 8px;

        line-height: 1.6;

        letter-spacing: 0.20em;

        color: rgba(245, 245, 245, 0.34);

    }



    .field-list span {

        position: relative;

    }



    .field-list span:not(:last-child)::after {

        content: "";

        position: absolute;

        right: -17px;

        top: 50%;

        width: 3px;

        height: 3px;

        transform: translateY(-50%);

        border-radius: 50%;

        background: var(--ca-pink);

    }



    /* SECCIONES */

    .profile-section {

        padding: 100px 0;

        border-bottom:

            1px solid var(--ca-line);

        background: #050505;

    }



    .parallel-section {

        background: #030303;

    }



    .traces-section {

        padding-bottom: 130px;

    }



    .profile-layout {

        display: grid;

        grid-template-columns:

            185px

            minmax(0, 760px);

        gap: 70px;

        align-items: start;

    }



    .section-aside {

        display: flex;

        flex-direction: column;

        gap: 11px;

        padding-top: 5px;

    }



    .section-aside span {

        font-size: 28px;

        font-weight: 300;

        line-height: 1;

        letter-spacing: -0.04em;

        color: rgba(245, 245, 245, 0.12);

    }



    .section-aside strong {

        font-size: 7px;

        font-weight: 400;

        line-height: 1.6;

        letter-spacing: 0.21em;

        color: rgba(245, 245, 245, 0.26);

    }



    .profile-label {

        display: block;

        margin-bottom: 23px;

        font-size: 9px;

        line-height: 1.5;

        letter-spacing: 0.25em;

        color: var(--ca-pink);

    }



    .profile-copy p {

        max-width: 760px;

        margin: 0;

        font-size: clamp(

            20px,

            2.1vw,

            30px

        );

        line-height: 1.5;

        letter-spacing: -0.018em;

        color: rgba(245, 245, 245, 0.74);

    }



    .external-link {

        display: inline-flex;

        align-items: center;

        gap: 13px;

        margin-top: 34px;

        font-size: 8px;

        line-height: 1.5;

        letter-spacing: 0.20em;

        color: rgba(245, 245, 245, 0.45);

        text-decoration: none;

    }



    .external-link span {

        color: var(--ca-pink);

    }



    .traces-heading {

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 30px;

        margin-bottom: 34px;

    }



    .traces-heading .profile-label {

        margin-bottom: 0;

    }



    .traces-count {

        font-size: 8px;

        line-height: 1.5;

        letter-spacing: 0.20em;

        color: rgba(245, 245, 245, 0.30);

    }



    .trace-list {

        border-top:

            1px solid rgba(255, 47, 109, 0.68);

    }



    .trace-row {

        position: relative;

        min-height: 155px;

        padding: 25px 0;

        display: grid;

        grid-template-columns:

            175px

            minmax(0, 1fr)

            35px;

        gap: 30px;

        align-items: center;

        color: inherit;

        text-decoration: none;

        border-bottom:

            1px solid var(--ca-line);

        transition:

            padding-left 0.25s ease,

*background* 0.25s ease;

    }



    .trace-row:hover {

        padding-left: 14px;

        background:

            linear-gradient(

                90deg,

                rgba(255, 47, 109, 0.045),

                transparent 62%

            );

    }



    .trace-meta {

        display: flex;

        flex-direction: column;

        gap: 6px;

        font-size: 7px;

        line-height: 1.55;

        letter-spacing: 0.18em;

        color: rgba(245, 245, 245, 0.27);

    }



    .trace-code {

        color: var(--ca-pink);

    }



    .trace-role {

        display: block;

        margin-bottom: 9px;

        font-size: 7px;

        line-height: 1.5;

        letter-spacing: 0.21em;

        color: rgba(255, 47, 109, 0.78);

    }



    .trace-main h3 {

        max-width: 560px;

        margin: 0;

        font-size: clamp(

            20px,

            2vw,

            28px

        );

        font-weight: 630;

        line-height: 1.12;

        letter-spacing: -0.025em;

        color: var(--ca-white);

    }



    .trace-arrow {

        justify-self: end;

        font-size: 22px;

        line-height: 1;

        color: var(--ca-pink);

        transition:

            transform 0.25s ease;

    }



    .trace-row:hover .trace-arrow {

        transform: translateX(6px);

    }



    .trace-empty {

        padding: 28px 0;

        display: grid;

        grid-template-columns:

            150px

            minmax(0, 1fr);

        gap: 10px 35px;

        border-top:

            1px solid rgba(255, 47, 109, 0.65);

        border-bottom:

            1px solid var(--ca-line);

    }



    .trace-empty > span {

        grid-row: 1 / 3;

        font-size: 8px;

        line-height: 1.5;

        letter-spacing: 0.20em;

        color: var(--ca-pink);

    }



    .trace-empty strong {

        font-size: 11px;

        font-weight: 500;

        line-height: 1.5;

        letter-spacing: 0.18em;

        color: rgba(245, 245, 245, 0.60);

    }



    .trace-empty small {

        max-width: 560px;

        font-size: 11px;

        line-height: 1.7;

        color: rgba(245, 245, 245, 0.33);

    }



    /* TABLET */

    @media (max-width: 1000px) {

        .profile-container {

            width: min(

                calc(100% - 48px),

                1200px

            );

        }



        .node-hero-layout,

        .profile-layout {

            grid-template-columns:

                150px

                minmax(0, 1fr);

            gap: 45px;

        }

    }



    /* MÓVIL */

    @media (max-width: 720px) {

        .profile-container {

            width: calc(100% - 40px);

        }



        .node-hero {

            min-height: auto;

            padding: 35px 0 82px;

        }



        .back-link {

            margin-bottom: 70px;

            font-size: 7px;

        }



        .node-hero-layout {

            display: block;

        }



        .node-aside {

            margin-bottom: 48px;

        }



        .node-heading h1 {

            font-size: clamp(

                52px,

                16vw,

                78px

            );

        }



        .field-list {

            display: block;

            margin-top: 34px;

        }



        .field-list span {

            display: block;

            margin-bottom: 7px;

        }



        .field-list span::after {

            display: none;

        }



        .node-ghost {

            right: -37%;

            font-size: 280px;

        }



        .profile-section {

            padding: 76px 0;

        }



        .profile-layout {

            display: block;

        }



        .section-aside {

            margin-bottom: 38px;

        }



        .profile-copy p {

            font-size: 20px;

            line-height: 1.55;

        }



        .traces-heading {

            align-items: flex-start;

            flex-direction: column;

            gap: 12px;

        }



        .trace-row {

            min-height: auto;

            grid-template-columns:

                1fr

                28px;

            gap: 19px;

            padding: 25px 0;

        }



        .trace-row:hover {

            padding-left: 0;

            background: transparent;

        }



        .trace-meta {

            grid-column: 1 / -1;

            flex-direction: row;

            flex-wrap: wrap;

            gap: 7px 18px;

        }



        .trace-main {

            grid-column: 1;

        }



        .trace-arrow {

            grid-column: 2;

            align-self: center;

        }



        .trace-empty {

            grid-template-columns: 1fr;

            gap: 13px;

        }



        .trace-empty > span {

            grid-row: auto;

        }

    }

</style>