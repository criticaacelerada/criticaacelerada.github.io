---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { nodes, getNodeBySlug } from "../../data/nodos";
import { getNodeTraces } from "../../lib/trazas";
import NodeYouTubeFeed from "../../components/NodeYouTubeFeed.astro";
import { formatShortDate } from "../../lib/editorial";

export function getStaticPaths() {
  return nodes.map((node) => ({
    params: { slug: node.slug },
  }));
}

const { slug } = Astro.params;
const node = getNodeBySlug(slug ?? "");

if (!node) {
  return Astro.redirect("/");
}

const traces = await getNodeTraces(node);
const hasProfessional = Boolean(node.professional?.trim());
const hasParallel = Boolean(node.parallel);
const hasBothBioColumns = hasProfessional && hasParallel;
---

<BaseLayout
  title={`${node.name} | Crítica Acelerada`}
  description={`Registro nodal de ${node.name} en Crítica Acelerada.`}
  lang="es"
  type="profile"
  author={node.name}
>
  <main class="node-profile">
    <section class="node-hero">
      <div class="container">
        <nav class="case-breadcrumb" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <span>Micelio</span>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{node.code}</span>
        </nav>

        <div class="node-topbar">
          <div class="node-identity">
            <span class="node-code">{node.code}</span>
            <span class="node-sep" aria-hidden="true">·</span>
            <span class="node-role">{node.role}</span>
          </div>

          <div class="node-topbar-right">
            {node.location && (
              <span class="node-location">{node.location}</span>
            )}
            <span class="node-status">{node.status}</span>
          </div>
        </div>

        <header class="node-header-grid">
          <div class="node-heading">
            <span class="eyebrow">REGISTRO NODAL</span>
            <h1>{node.name}</h1>
          </div>

          <div class="field-list" aria-label="Líneas de investigación">
            {node.fields.map((field) => <span>{field}</span>)}
          </div>
        </header>
      </div>
    </section>

    {
      (hasProfessional || hasParallel) && (
        <section class="profile-section bio-section">
          <div class="container">
            <div class:list={["bio-grid", { "is-single": !hasBothBioColumns }]}>
              {hasProfessional && (
                <article class="bio-col">
                  <h2 class="section-code">01 / TRAYECTORIA</h2>
                  <span class="bio-sublabel">TRABAJO PROFESIONAL</span>
                  <p>{node.professional}</p>
                </article>
              )}

              {hasParallel && node.parallel && (
                <article class="bio-col">
                  <h2 class="section-code">
                    {hasProfessional ? "02" : "01"} / PRÁCTICA PARALELA
                  </h2>
                  <span class="bio-sublabel">{node.parallel.title}</span>
                  <p>{node.parallel.description}</p>

                  {node.parallel.url && (
                    <a
                      class="external-link"
                      href={node.parallel.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {node.parallel.label ?? "VISITAR PROYECTO"}
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </article>
              )}
            </div>
          </div>
        </section>
      )
    }

    <section class="profile-section traces-section">
      <div class="container">
        <div class="section-bar">
          <h2 class="section-code">03 / TRAZAS EN CA</h2>
          <span class="traces-count">
            {String(traces.length).padStart(2, "0")} TRAZAS
          </span>
        </div>

        {
          traces.length > 0 ? (
            <div class="trace-table">
              {traces.map((trace) => (
                <a class="trace-row" href={trace.href}>
                  <span class="trace-code">{trace.code}</span>

                  <h3 class="trace-title">{trace.title}</h3>

                  <span class="trace-classification">
                    <span class="trace-role">{trace.role}</span>
                    <span class="trace-sep" aria-hidden="true">/</span>
                    <span class="trace-type">{trace.type}</span>
                  </span>

                  <time
                    class="trace-date"
                    datetime={trace.date.toISOString().slice(0, 10)}
                  >
                    {formatShortDate(trace.date)}
                  </time>

                  <span class="trace-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              ))}
            </div>
          ) : (
            <div class="trace-empty">
              <span>CA / SISTEMA</span>
              <strong>SIN TRAZAS REGISTRADAS</strong>
              <small>
                Este nodo todavía no aparece en los metadatos de los archivos
                sincronizados.
              </small>
            </div>
          )
        }
      </div>
    </section>

    {
      node.youtube && (
        <section class="profile-section external-activity-section">
          <div class="container">
            <div class="section-bar">
              <h2 class="section-code">04 / ACTIVIDAD EXTERNA</h2>
              <span class="section-meta">CORRIENTE DEL NODO</span>
            </div>

            <p class="activity-intro">
              Publicaciones recientes del canal de YouTube asociado a este nodo.
              Una ventana hacia su práctica externa y hacia los proyectos que
              orbitan alrededor del nodo.
            </p>

            <NodeYouTubeFeed
              handle={node.youtube.handle}
              label={node.youtube.label}
              url={node.youtube.url}
            />
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .node-profile {
    background: var(--bg);
    color: var(--text);
    overflow-x: clip;
  }

  /* ============================================================
     1. BARRA SUPERIOR NODAL Y 2. ENCABEZADO HORIZONTAL
  ============================================================ */

  .node-hero {
    padding: 2.25rem 0 3.75rem;
    border-bottom: 1px solid var(--border);
  }

  .node-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding: 0.25rem 0 1.05rem;
    border-bottom: 1px solid var(--accent);
  }

  .node-identity {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .node-code {
    font-weight: 500;
    color: var(--accent-text);
  }

  .node-sep {
    color: var(--meta);
  }

  .node-role {
    color: var(--muted);
  }

  .node-topbar-right {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.35rem;
  }

  .node-location {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    color: var(--meta);
  }

  .node-status {
    position: relative;
    padding-left: 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--text);
  }

  .node-status::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 6px;
    height: 6px;
    transform: translateY(-50%);
    border-radius: 50%;
    background: var(--accent);
  }

  .node-header-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 2rem 3.5rem;
    align-items: end;
    padding-top: 2.5rem;
  }

  .node-heading {
    min-width: 0;
  }

  .node-heading h1 {
    margin: 0.75rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 4.6vw, 3.75rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--text);
    text-wrap: balance;
  }

  .field-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-content: flex-end;
    gap: 0.45rem;
    padding-bottom: 0.2rem;
  }

  .field-list span {
    padding: 0.32rem 0.65rem;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.35;
    letter-spacing: 0.08em;
  }

  /* ============================================================
     3. SECCIONES 01 / TRAYECTORIA Y 02 / PRÁCTICA PARALELA
  ============================================================ */

  .profile-section {
    padding: 3.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .profile-section:last-child {
    border-bottom: 0;
  }

  .section-code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }

  .bio-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
  }

  .bio-grid.is-single {
    grid-template-columns: 1fr;
  }

  .bio-col {
    min-width: 0;
  }

  .bio-grid:not(.is-single) .bio-col:first-child {
    padding-right: 3rem;
  }

  .bio-grid:not(.is-single) .bio-col:last-child {
    padding-left: 3rem;
    border-left: 1px solid var(--border-subtle);
  }

  .bio-sublabel {
    display: block;
    margin: 0.65rem 0 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--meta);
  }

  .bio-col p,
  .activity-intro {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.78;
    color: var(--text-body);
  }

  .bio-grid.is-single .bio-col p,
  .activity-intro {
    max-width: 72ch;
  }

  .external-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    color: var(--accent-text);
    border-bottom: 1px solid var(--accent);
    transition: color 0.2s ease;
  }

  .external-link:hover {
    color: var(--text);
  }

  /* ============================================================
     4. 03 / TRAZAS EN CA — TABLA EDITORIAL HORIZONTAL
  ============================================================ */

  .section-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-strong);
  }

  .traces-count,
  .section-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--meta);
    font-variant-numeric: tabular-nums;
  }

  .trace-table {
    display: flex;
    flex-direction: column;
  }

  .trace-row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) 235px 96px 24px;
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.1rem 0.65rem;
    margin-inline: -0.65rem;
    border-bottom: 1px solid var(--border-subtle);
    transition: background-color 0.2s ease;
  }

  .trace-row:hover {
    background: var(--surface);
  }

  .trace-code {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }

  .trace-title {
    margin: 0;
    min-width: 0;
    font-family: var(--font-serif);
    font-size: 1.12rem;
    font-weight: 500;
    line-height: 1.32;
    color: var(--text);
    transition: color 0.2s ease;
  }

  .trace-row:hover .trace-title {
    color: var(--accent-text);
  }

  .trace-classification {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    line-height: 1.45;
    color: var(--muted);
  }

  .trace-sep {
    margin-inline: 0.25rem;
    color: var(--meta);
  }

  .trace-type {
    color: var(--meta);
  }

  .trace-date {
    text-align: right;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--meta);
    font-variant-numeric: tabular-nums;
  }

  .trace-arrow {
    text-align: right;
    font-size: 1rem;
    line-height: 1;
    color: var(--accent-text);
    transition: transform 0.2s ease;
  }

  .trace-row:hover .trace-arrow {
    transform: translateX(4px);
  }

  .trace-empty {
    margin-top: 1.5rem;
    padding: 2rem;
    border: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .trace-empty span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--accent-text);
  }

  .trace-empty strong {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--text);
  }

  .trace-empty small {
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* ============================================================
     ACTIVIDAD EXTERNA (YOUTUBE)
  ============================================================ */

  .activity-intro {
    margin-top: 1.5rem;
  }

  /* ============================================================
     5. RESPONSIVO (TABLET Y MÓVIL)
  ============================================================ */

  @media (max-width: 1024px) {
    .trace-row {
      grid-template-columns: 165px minmax(0, 1fr) 195px 88px 20px;
      gap: 0.95rem;
    }
  }

  @media (max-width: 900px) {
    .node-header-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      align-items: start;
      padding-top: 2rem;
    }

    .field-list {
      justify-content: flex-start;
      padding-bottom: 0;
    }

    .bio-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .bio-grid:not(.is-single) .bio-col:first-child {
      padding-right: 0;
    }

    .bio-grid:not(.is-single) .bio-col:last-child {
      padding-left: 0;
      padding-top: 2.5rem;
      border-left: 0;
      border-top: 1px solid var(--border-subtle);
    }
  }

  @media (max-width: 820px) {
    .node-hero {
      padding: 1.75rem 0 2.75rem;
    }

    .profile-section {
      padding: 2.75rem 0;
    }

    .trace-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.45rem 1rem;
      align-items: center;
      padding: 1.15rem 0;
      margin-inline: 0;
    }

    .trace-row:hover {
      background: transparent;
    }

    .trace-code {
      grid-column: 1;
      grid-row: 1;
    }

    .trace-date {
      grid-column: 2;
      grid-row: 1;
    }

    .trace-title {
      grid-column: 1;
      grid-row: 2;
      font-size: 1.15rem;
    }

    .trace-classification {
      grid-column: 1;
      grid-row: 3;
    }

    .trace-arrow {
      grid-column: 2;
      grid-row: 2 / span 2;
      align-self: center;
    }
  }
</style>
