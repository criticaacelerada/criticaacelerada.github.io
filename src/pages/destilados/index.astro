---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { formatShortDate } from "../../lib/editorial";
import destiladosVisual from "../../assets/images/destilados.png";

const documentos = await getCollection("destilados");

const grupos = new Map<string, typeof documentos>();

for (const documento of documentos) {
  const clave = documento.data.translationKey ?? `individual-${documento.id}`;
  const bucket = grupos.get(clave) ?? [];
  bucket.push(documento);
  grupos.set(clave, bucket);
}

const destilados = Array.from(grupos.values())
  .map((versiones) => {
    const principal =
      versiones.find((version) => version.data.language === "es") ??
      versiones[0];

    const idiomas = [...versiones].sort((a, b) => {
      const orden = ["es", "en"];
      return orden.indexOf(a.data.language) - orden.indexOf(b.data.language);
    });

    return {
      principal,
      idiomas,
    };
  })
  .sort(
    (a, b) =>
      b.principal.data.pubDate.getTime() - a.principal.data.pubDate.getTime()
  );
---

<BaseLayout
  title="Destilados | Crítica Acelerada"
  description="Síntesis críticas de libros, artículos y textos fundamentales del laboratorio Crítica Acelerada."
  lang="es"
>
  <main class="archive-page">
    <div class="container">
      <section class="archive-hero">
        <div class="archive-intro">
          <p class="eyebrow">DESTILADOS</p>
          <h1>Archivo</h1>
          <p class="mission">
            Síntesis críticas de libros, artículos y textos relevantes para las
            líneas de investigación del laboratorio.
          </p>

          <div class="archive-meta">
            <span>CRÍTICA ACELERADA</span>
            <span>{String(destilados.length).padStart(2, "0")} DOCUMENTOS</span>
          </div>
        </div>

        <div class="archive-visual" aria-hidden="true">
          <Image
            src={destiladosVisual}
            alt=""
            widths={[320, 540]}
            sizes="270px"
            format="webp"
            quality={85}
          />
          <p>ARCHIVO DESTILADO</p>
        </div>
      </section>

      <section class="archive-list">
        <div class="archive-list-header">
          <span>N.º</span>
          <span>DOCUMENTO</span>
          <span>IDIOMA</span>
        </div>

        {
          destilados.map(({ principal, idiomas }) => (
            <article class="essay">
              <div class="number">
                {String(principal.data.numero).padStart(3, "0")}
              </div>

              <div class="content">
                <h3>
                  <a href={`/destilados/${principal.id}`}>
                    {principal.data.title}
                  </a>
                </h3>

                <p>{principal.data.description}</p>

                <div class="essay-meta-row">
                  <span>{principal.data.autor}</span>
                  <time datetime={principal.data.pubDate.toISOString().slice(0, 10)}>
                    {formatShortDate(principal.data.pubDate)}
                  </time>
                </div>
              </div>

              <div class="essay-actions">
                {idiomas.length > 1 ? (
                  <div class="language-switch" aria-label="Idiomas disponibles">
                    {idiomas.map((version) => (
                      <a
                        class:list={[
                          "language-chip",
                          { "is-primary": version.id === principal.id },
                        ]}
                        href={`/destilados/${version.id}`}
                        lang={version.data.language}
                        aria-label={`Leer ${principal.data.title} en ${version.data.language.toUpperCase()}`}
                      >
                        {version.data.language.toUpperCase()}
                      </a>
                    ))}
                  </div>
                ) : (
                  <a class="read-link" href={`/destilados/${principal.id}`}>
                    Leer →
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </section>
    </div>
  </main>
</BaseLayout>
