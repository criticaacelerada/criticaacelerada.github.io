---
import "../../styles/global.css";
import HomeButton from "../../components/HomeButton.astro";
import SocialFooter from "../../components/SocialFooter.astro";
import { getCollection } from "astro:content";

const ensayos = await getCollection("ensayos");

/*
Agrupa los documentos que comparten translationKey.
Los ensayos sin traducción permanecen como entradas individuales.
*/
const grupos = new Map();

for (const ensayo of ensayos) {
  const clave = ensayo.data.translationKey ?? `individual-${ensayo.id}`;

  if (!grupos.has(clave)) {
    grupos.set(clave, []);
  }

  grupos.get(clave).push(ensayo);
}

const expedientes = Array.from(grupos.values())
  .map((versiones) => {
    /*
    La versión inglesa funciona como referencia editorial.
    Si no existe, utiliza la primera versión disponible.
    */
    const principal =
      versiones.find((version) => version.data.language === "en") ??
      versiones[0];

    const idiomas = versiones.sort((a, b) => {
      const orden = ["en", "es"];

      return (
        orden.indexOf(a.data.language) -
        orden.indexOf(b.data.language)
      );
    });

    return {
      principal,
      idiomas,
    };
  })
  .sort(
    (a, b) =>
      a.principal.data.expediente -
      b.principal.data.expediente
  );
---

<html lang="es">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Expedientes | Crítica Acelerada</title>
</head>

<body>

<SocialFooter />

<HomeButton />

  <main class="archive-page">

    <div class="container">

      <section class="archive-hero">

        <div class="archive-intro">

          <p class="eyebrow">
            EXPEDIENTES
          </p>

          <h1>
            Archivo
          </h1>

          <p class="mission">
            Ensayos, investigaciones y documentos del laboratorio.
          </p>

          <div class="archive-meta">
            <span>CRÍTICA ACELERADA</span>
            <span>{String(expedientes.length).padStart(2, "0")} DOCUMENTOS</span>
          </div>

        </div>

        <div class="archive-visual" aria-hidden="true">

          <div class="archive-logo">
            <span>C</span>
          </div>

          <img
            src="/images/expedientes.png"
            alt=""
          />

          <p>
            LABORATORIO DE ESTUDIOS CRÍTICOS
          </p>

        </div>

      </section>

      <section class="archive-list">

        <div class="archive-list-header">
          <span>N.º</span>
          <span>DOCUMENTO</span>
          <span>IDIOMA</span>
        </div>

        {
          expedientes.map(({ principal, idiomas }) => (

            <article class="essay">

              <div class="number">
                {String(principal.data.expediente).padStart(3, "0")}
              </div>

              <div class="content">

                <h3>
                  {principal.data.title}
                </h3>

                <p>
                  {principal.data.descripcion}
                </p>

              </div>

              <div class="essay-actions">

                {
                  idiomas.length > 1 ? (

                    <div class="language-switch">

                      {
                        idiomas.map((version) => (
                          <a
                            class="language-chip"
                            href={`/expedientes/${version.id}`}
                            lang={version.data.language}
                            aria-label={`Abrir versión ${version.data.language.toUpperCase()}`}
                          >
                            {version.data.language.toUpperCase()}
                          </a>
                        ))
                      }

                    </div>

                  ) : (

                    <a
                      class="read-link"
                      href={`/expedientes/${principal.id}`}
                    >
                      Leer →
                    </a>

                  )
                }

              </div>

            </article>

          ))
        }

      </section>

    </div>

  </main>

</body>

</html>