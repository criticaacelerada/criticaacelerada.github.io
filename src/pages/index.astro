---
import "../styles/global.css";
import SocialFooter from "../components/SocialFooter.astro";
import { getCollection } from "astro:content";

const [ensayosTodos, transmisiones, destiladosTodos, alicuotasTodos] = await Promise.all([
    getCollection("ensayos"),
    getCollection("transmisiones"),
    getCollection("destilados"),
    getCollection("alicuotas"),
]);

const ensayos = ensayosTodos.filter(
    (entry) => entry.data.language === "es"
);

const destilados = destiladosTodos.filter(
    (entry) => entry.data.language === "es"
);

const alicuotas = alicuotasTodos.filter(
    (entry) => entry.data.language === "es"
);

const publicaciones = [
    ...ensayos.flatMap((entry) => {
        const traduccionEn = entry.data.translationKey
            ? ensayosTodos.find(
                (candidate) =>
                    candidate.data.language === "en" &&
                    candidate.data.translationKey === entry.data.translationKey
            )
            : undefined;

        const expediente = {
            id: entry.id,
            codigo: `EXPEDIENTE ${String(entry.data.expediente).padStart(3, "0")}`,
            tipo: "ARCHIVO TEXTUAL",
            fecha: entry.data.date,
            titulo: entry.data.title,
            descripcion: entry.data.descripcion,
            autor: entry.data.author ?? "CRÍTICA ACELERADA",
            hrefEs: `/expedientes/${entry.id}`,
            hrefEn: traduccionEn
                ? `/expedientes/${traduccionEn.id}`
                : null,
        };

        if (!entry.data.video) {
            return [expediente];
        }

        const audiovisual = {
            id: `${entry.id}-audiovisual`,
            codigo: `ARCHIVO AUDIOVISUAL / ${String(entry.data.expediente).padStart(3, "0")}`,
            tipo: "MATERIAL ASOCIADO",
            fecha: entry.data.video.date,
            titulo: entry.data.video.title,
            descripcion: "Material audiovisual asociado a este expediente.",
            autor: entry.data.author ?? "CRÍTICA ACELERADA",
            hrefEs: `/expedientes/${entry.id}`,
            hrefEn: traduccionEn
                ? `/expedientes/${traduccionEn.id}`
                : null,
        };

        return [expediente, audiovisual];
    }),

    ...transmisiones.map((entry) => ({
        id: entry.id,
        codigo: `TRANSMISIÓN ${String(entry.data.numero).padStart(3, "0")}`,
        tipo: "ARCHIVO AUDIOVISUAL",
        fecha: entry.data.pubDate,
        titulo: entry.data.title,
        descripcion: entry.data.description,
        autor: "CRÍTICA ACELERADA",
        hrefEs: `/transmisiones/${entry.id}`,
        hrefEn: null,
    })),

    ...destilados.map((entry) => {
        const traduccionEn = entry.data.translationKey
            ? destiladosTodos.find(
                (candidate) =>
                    candidate.data.language === "en" &&
                    candidate.data.translationKey === entry.data.translationKey
            )
            : undefined;

        return {
            id: entry.id,
            codigo: `DESTILADO ${String(entry.data.numero).padStart(3, "0")}`,
            tipo: "ARCHIVO DESTILADO",
            fecha: entry.data.pubDate,
            titulo: entry.data.title,
            descripcion: entry.data.description,
            autor: entry.data.autor,
            hrefEs: `/destilados/${entry.id}`,
            hrefEn: traduccionEn
                ? `/destilados/${traduccionEn.id}`
                : null,
        };
    }),

    ...alicuotas.map((entry) => {
        const traduccionEn = entry.data.translationKey
            ? alicuotasTodos.find(
                (candidate) =>
                    candidate.data.language === "en" &&
                    candidate.data.translationKey === entry.data.translationKey
            )
            : undefined;

        return {
            id: entry.id,
            codigo: `AE—${String(entry.data.numero).padStart(3, "0")}`,
            tipo: "ARCHIVO EXPERIMENTAL",
            fecha: entry.data.pubDate,
            titulo: entry.data.title,
            descripcion: entry.data.description,
            autor: entry.data.autor,
            hrefEs: `/alicuotas/${entry.id}`,
            hrefEn: traduccionEn
                ? `/alicuotas/${traduccionEn.id}`
                : null,
        };
    }),
];

const masReciente = publicaciones.sort(
    (a, b) => b.fecha.getTime() - a.fecha.getTime()
)[0];

const formatearFecha = (fecha: Date) =>
    new Intl.DateTimeFormat("es-MX", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
    })
        .format(fecha)
        .replaceAll("/", ".");
---


<!doctype html>
<html lang="es">

<head>
    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <meta
        name="description"
        content="Crítica Acelerada — Laboratorio de Economía Política y Filosofía del Capitalismo Contemporáneo."
    />

    <meta
        name="theme-color"
        content="#050505"
    />

    <title>Crítica Acelerada</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>

<body>

    <main class="home">

        <!-- =====================================================
             HERO
        ====================================================== -->

        <section class="home-hero">

            <!-- RETÍCULA -->
            <div
                class="hero-grid-background"
                aria-hidden="true"
            ></div>

            <!-- MARCAS DE ENCUADRE -->
            <div
                class="hero-frame"
                aria-hidden="true"
            >
                <span class="corner corner-tl"></span>
                <span class="corner corner-tr"></span>
                <span class="corner corner-bl"></span>
                <span class="corner corner-br"></span>
            </div>


            <!-- CONTENIDO PRINCIPAL -->
            <div class="home-container hero-layout">

                <!-- IZQUIERDA -->
                <div class="hero-copy">

                    <div class="hero-meta">

                        <p class="eyebrow">
                            LABORATORIO DE ESTUDIOS CRÍTICOS
                        </p>

                        <div class="research-fields">
                            <span>ECONOMÍA POLÍTICA</span>
                            <span>FILOSOFÍA</span>
                            <span>CAPITALISMO CONTEMPORÁNEO</span>
                        </div>

                    </div>

                    <div class="hero-title">

                        <h1>
                            <span>CRÍTICA</span>
                            <span>ACELERADA</span>
                        </h1>

                        <p class="mission">
                            Impensar las categorías heredadas para comprender
                            las transformaciones tecnológicas, económicas y
                            filosóficas del presente.
                        </p>

                    </div>

                </div>


                <!-- OBJETO VISUAL -->
                <div
                    class="hero-visual"
                    aria-hidden="true"
                >

                    <div class="visual-glow"></div>

                    <img
                        src="/images/ca-home-visual.jpeg"
                        alt=""
                        class="hero-art"
                    />

                    <div class="visual-fade"></div>

                </div>


                <!-- DATOS LATERALES -->
                <div
                    class="system-data"
                    aria-hidden="true"
                >

                    <span class="system-code">
                        CA-LAB // 001
                    </span>

                    <div class="system-line"></div>

                    <span>
                        ARCHIVO LIBERADO
                    </span>

                    <span>
                        NIVEL DE ACCESO
                    </span>

                    <strong>
                        PÚBLICO
                    </strong>

                    <div class="system-accent"></div>

                </div>

            </div>


            <!-- FRANJA INFERIOR -->
            <div class="home-container hero-bottom">

                <div class="hero-bottom-block">

                    <span
                        class="bottom-marker"
                        aria-hidden="true"
                    ></span>

                    <div>

                        <strong>
                            INVESTIGACIÓN INDEPENDIENTE
                        </strong>

                        <span>
                            PENSAMIENTO CRÍTICO
                        </span>

                        <span>
                            FUTUROS POSIBLES
                        </span>

                    </div>

                </div>


                <div class="hero-bottom-block hero-bottom-archive">

                    <div>

                        <strong>
                            ARCHIVOS DEL LABORATORIO
                        </strong>

                        <span>
                            DOCUMENTOS
                            <i>›</i>
                            ANÁLISIS
                            <i>›</i>
                            TRANSMISIONES
                            <i>›</i>
                            EXPERIMENTACIÓN
                        </span>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             TRANSICIÓN
        ====================================================== -->

        <div class="hero-transition" aria-hidden="true">

            <div class="home-container transition-inner">

                <span>CA / TRANSICIÓN</span>

                <div class="transition-line"></div>

                <span>001</span>

            </div>

        </div>


        <!-- =====================================================
             MANIFIESTO
        ====================================================== -->

        <section class="manifest-section">

            <div
                class="manifest-grid"
                aria-hidden="true"
            ></div>

            <div
                class="manifest-ghost"
                aria-hidden="true"
            >
                01
            </div>


            <div class="home-container manifest-inner">


                <!-- COLUMNA IZQUIERDA -->
                <aside class="manifest-aside">

                    <span class="manifest-code">
                        CA / SISTEMA
                    </span>

                    <span class="manifest-index">
                        DECLARACIÓN / 001
                    </span>

                    <div class="manifest-aside-line"></div>

                    <span class="manifest-status">
                        PENSAMIENTO CRÍTICO
                    </span>

                </aside>


                <!-- TEXTO -->
                <div class="manifest-content">

                    <p class="manifest-intro">
                        NO INVESTIGAMOS LO OCULTO;
                    </p>

                    <p class="manifest-text">
                        INVESTIGAMOS AQUELLO QUE AÚN NO HA SIDO
                        PENSADO CON SUFICIENTE RIGOR.
                    </p>


                    <div
                        class="manifest-bottom"
                        aria-hidden="true"
                    >

                        <span>
                            ECONOMÍA POLÍTICA
                        </span>

                        <i></i>

                        <span>
                            FILOSOFÍA
                        </span>

                        <i></i>

                        <span>
                            CAPITALISMO CONTEMPORÁNEO
                        </span>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             REGISTRO MÁS RECIENTE
        ====================================================== -->

        {
            masReciente && (

                <section class="latest-section">

                    <div
                        class="latest-ghost"
                        aria-hidden="true"
                    >
                        02
                    </div>

                    <div class="home-container latest-inner">

                        <aside class="latest-aside">

                            <span class="latest-system-code">
                                CA / REGISTRO
                            </span>

                            <span class="latest-index">
                                ACTUALIZACIÓN / 002
                            </span>

                            <div class="latest-aside-line"></div>

                            <span class="latest-status">
                                PUBLICACIÓN MÁS RECIENTE
                            </span>

                        </aside>


                        <div class="latest-entry">

                            <div class="latest-meta">

                                <span class="latest-code">
                                    {masReciente.codigo}
                                </span>

                                <span>
                                    {masReciente.tipo}
                                </span>

                                <span class="latest-date">
                                    {formatearFecha(masReciente.fecha)}
                                </span>

                            </div>


                            <h2>
                                {masReciente.titulo}
                            </h2>


                            <p class="latest-description">
                                {masReciente.descripcion}
                            </p>


                            <div class="latest-footer">

                                <span class="latest-author">
                                    {masReciente.autor}
                                </span>

                                <div
                                    class="latest-languages"
                                    aria-label="Idiomas disponibles"
                                >

                                    <a
                                        class="latest-read"
                                        href={masReciente.hrefEs}
                                        aria-label={`Leer ${masReciente.titulo} en español`}
                                    >
                                        ESPAÑOL
                                        <i>→</i>
                                    </a>

                                    {
                                        masReciente.hrefEn && (
                                            <a
                                                class="latest-read"
                                                href={masReciente.hrefEn}
                                                aria-label={`Read ${masReciente.titulo} in English`}
                                            >
                                                ENGLISH
                                                <i>→</i>
                                            </a>
                                        )
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </section>

            )
        }


        <!-- =====================================================
             ARCHIVOS
        ====================================================== -->

        <section class="archive-section">

            <div class="home-container">


                <!-- CABECERA -->
                <header class="archive-header">

                    <div>

                        <span class="section-eyebrow">
                            ESTRUCTURA DEL LABORATORIO
                        </span>

                        <h2>
                            ARCHIVOS
                        </h2>

                    </div>

                    <span class="archive-count">
                        04 ARCHIVOS ACTIVOS
                    </span>

                </header>


                <!-- LISTA -->
                <div class="portal-list">


                    <!-- EXPEDIENTES -->
                    <a
                        href="/expedientes"
                        class="portal-row"
                    >

                        <div class="portal-number">
                            01
                        </div>


                        <div class="portal-main">

                            <div class="portal-meta">

                                <span>
                                    CA / 01
                                </span>

                                <span>
                                    ARCHIVO TEXTUAL
                                </span>

                            </div>


                            <h3>
                                EXPEDIENTES
                            </h3>


                            <p>
                                Ensayos, investigaciones y documentos críticos
                                para analizar las transformaciones del capitalismo
                                contemporáneo.
                            </p>

                        </div>


                        <div class="portal-action">

                            <span>
                                ENTRAR AL ARCHIVO
                            </span>

                            <span class="portal-arrow">
                                →
                            </span>

                        </div>

                    </a>


                    <!-- TRANSMISIONES -->
                    <a
                        href="/transmisiones"
                        class="portal-row"
                    >

                        <div class="portal-number">
                            02
                        </div>


                        <div class="portal-main">

                            <div class="portal-meta">

                                <span>
                                    CA / 02
                                </span>

                                <span>
                                    ARCHIVO AUDIOVISUAL
                                </span>

                            </div>


                            <h3>
                                TRANSMISIONES
                            </h3>


                            <p>
                                Videos, monólogos, conversaciones y registros
                                audiovisuales producidos por el laboratorio.
                            </p>

                        </div>


                        <div class="portal-action">

                            <span>
                                ACCEDER
                            </span>

                            <span class="portal-arrow">
                                →
                            </span>

                        </div>

                    </a>


                    <!-- DESTILADOS -->
                    <a
                        href="/destilados"
                        class="portal-row"
                    >

                        <div class="portal-number">
                            03
                        </div>


                        <div class="portal-main">

                            <div class="portal-meta">

                                <span>
                                    CA / 03
                                </span>

                                <span>
                                    ARCHIVO DESTILADO
                                </span>

                            </div>


                            <h3>
                                DESTILADOS
                            </h3>


                            <p>
                                Síntesis críticas de libros, artículos y textos
                                fundamentales para el análisis del capitalismo
                                contemporáneo.
                            </p>

                        </div>


                        <div class="portal-action">

                            <span>
                                EXPLORAR
                            </span>

                            <span class="portal-arrow">
                                →
                            </span>

                        </div>

                    </a>


                    <!-- ALÍCUOTAS EXPERIMENTALES -->
                    <a
                        href="/alicuotas"
                        class="portal-row"
                    >

                        <div class="portal-number">
                            04
                        </div>


                        <div class="portal-main">

                            <div class="portal-meta">

                                <span>
                                    CA / 04
                                </span>

                                <span>
                                    ARCHIVO EXPERIMENTAL
                                </span>

                            </div>


                            <h3>
                                ALÍCUOTAS EXPERIMENTALES
                            </h3>


                            <p>
                                Fragmentos, intervenciones y muestras textuales
                                donde el lenguaje funciona como materia de
                                experimentación crítica.
                            </p>

                        </div>


                        <div class="portal-action">

                            <span>
                                EXTRAER MUESTRA
                            </span>

                            <span class="portal-arrow">
                                →
                            </span>

                        </div>

                    </a>

                </div>

            </div>

        </section>


        <!-- =====================================================
             MICELIO
        ====================================================== -->

        <section class="mycelium-section">

            <div
                class="mycelium-grid-background"
                aria-hidden="true"
            ></div>

            <div
                class="mycelium-ghost"
                aria-hidden="true"
            >
                03
            </div>

            <div class="home-container">

                <!-- CABECERA -->
                <header class="mycelium-header">

                    <div>

                        <span class="section-eyebrow">
                            ESTRUCTURA DEL LABORATORIO
                        </span>

                        <h2>
                            MICELIO
                        </h2>

                    </div>

                    <span class="mycelium-count">
                        02 NODOS ACTIVOS
                    </span>

                </header>


                <!-- INTRODUCCIÓN -->
                <div class="mycelium-intro">

                    <span class="mycelium-code">
                        CA / REGISTRO NODAL
                    </span>

                    <p>
                        Crítica Acelerada se articula como una red de nodos,
                        trayectorias y procesos de co-agenciamiento. Las funciones
                        nodales describen el estado dentro del micelio, no rangos
                        jerárquicos.
                    </p>

                </div>


                <!-- NODOS -->
                <div class="node-grid">

                    <!-- OLIVER -->
                    <a
                        href="/nodos/oliver-ferran"
                        class="node-card"
                        aria-label="Abrir perfil nodal de Oliver Ferran"
                    >

                        <div class="node-top">

                            <span class="node-number">
                                01
                            </span>

                            <span class="node-status">
                                ACTIVO
                            </span>

                        </div>

                        <div class="node-meta">

                            <span>
                                CA / NODO 001
                            </span>

                            <span>
                                NODO SEMILLA
                            </span>

                        </div>

                        <h3>
                            OLIVER FERRAN
                        </h3>

                        <p class="node-description">
                            Economía política, tecnología, capitalismo y crítica
                            de las transformaciones contemporáneas.
                        </p>

                        <div class="node-footer">

                            <span class="node-traces">
                                REGISTRO EN CONSTRUCCIÓN
                            </span>

                            <span class="node-trace">
                                RASTREAR NODO
                                <i>→</i>
                            </span>

                        </div>

                    </a>


                    <!-- DIEGO -->
                    <a
                        href="/nodos/diego-gimenez-vila"
                        class="node-card"
                        aria-label="Abrir perfil nodal de Diego Giménez Vila"
                    >

                        <div class="node-top">

                            <span class="node-number">
                                02
                            </span>

                            <span class="node-status">
                                ACTIVO
                            </span>

                        </div>

                        <div class="node-meta">

                            <span>
                                CA / NODO 002
                            </span>

                            <span>
                                NODO DE CO-AGENCIAMIENTO
                            </span>

                        </div>

                        <h3>
                            DIEGO GIMÉNEZ VILA
                        </h3>

                        <p class="node-description">
                            Filosofía, ontología, capitalismo, técnica y
                            experimentación conceptual.
                        </p>

                        <div class="node-footer">

                            <span class="node-traces">
                                REGISTRO EN CONSTRUCCIÓN
                            </span>

                            <span class="node-trace">
                                RASTREAR NODO
                                <i>→</i>
                            </span>

                        </div>

                    </a>

                </div>

            </div>

        </section>

    </main>


    <SocialFooter />

</body>

</html>


<style>

    /* ============================================================
       BASE
    ============================================================ */

    .home {
        --ca-black: #050505;
        --ca-black-deep: #020202;
        --ca-surface: #0a0a0a;

        --ca-white: #f5f5f5;
        --ca-grey: rgba(245, 245, 245, 0.56);
        --ca-muted: rgba(245, 245, 245, 0.28);
        --ca-line: rgba(245, 245, 245, 0.12);

        --ca-pink: #ff2f6d;

        background: var(--ca-black);
        color: var(--ca-white);

        overflow: hidden;
    }


    .home-container {
        width: min(
            1200px,
            calc(100% - 80px)
        );

        margin-inline: auto;
    }



    /* ============================================================
       HERO
    ============================================================ */

    .home-hero {
        position: relative;

        min-height: 790px;

        padding-top: 72px;

        overflow: hidden;
        isolation: isolate;

        background:
            radial-gradient(
                circle at 76% 40%,
                rgba(255, 47, 109, 0.045),
                transparent 34%
            ),
            #050505;
    }



    /* ============================================================
       RETÍCULA
    ============================================================ */

    .hero-grid-background {
        position: absolute;
        inset: 0;

        z-index: -3;

        pointer-events: none;

        background-image:
            linear-gradient(
                rgba(255, 255, 255, 0.018) 1px,
                transparent 1px
            ),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.018) 1px,
                transparent 1px
            );

        background-size: 42px 42px;

        -webkit-mask-image:
            linear-gradient(
                to bottom,
                rgba(0, 0, 0, 0.9),
                rgba(0, 0, 0, 0.55) 68%,
                transparent 100%
            );

        mask-image:
            linear-gradient(
                to bottom,
                rgba(0, 0, 0, 0.9),
                rgba(0, 0, 0, 0.55) 68%,
                transparent 100%
            );
    }



    /* ============================================================
       MARCAS DE ENCUADRE
    ============================================================ */

    .hero-frame {
        position: absolute;
        inset: 31px;

        z-index: 8;

        pointer-events: none;
    }


    .corner {
        position: absolute;

        width: 26px;
        height: 26px;

        opacity: 0.68;
    }


    .corner-tl {
        top: 0;
        left: 0;

        border-top: 1px solid var(--ca-pink);
        border-left: 1px solid var(--ca-pink);
    }


    .corner-tr {
        top: 0;
        right: 0;

        border-top: 1px solid var(--ca-pink);
        border-right: 1px solid var(--ca-pink);
    }


    .corner-bl {
        bottom: 0;
        left: 0;

        border-bottom: 1px solid var(--ca-pink);
        border-left: 1px solid var(--ca-pink);
    }


    .corner-br {
        bottom: 0;
        right: 0;

        border-bottom: 1px solid var(--ca-pink);
        border-right: 1px solid var(--ca-pink);
    }



    /* ============================================================
       HERO — COMPOSICIÓN
    ============================================================ */

    .hero-layout {
        position: relative;

        min-height: 575px;

        display: flex;
        align-items: flex-start;
    }



    /* ============================================================
       HERO — COPY
    ============================================================ */

    .hero-copy {
        position: relative;
        z-index: 5;

        width: 67%;

        padding-top: 8px;
    }


    .hero-meta {
        margin-bottom: 57px;
    }


    .eyebrow {
        margin: 0 0 25px;

        font-size: 12px;
        line-height: 1.4;
        font-weight: 500;

        letter-spacing: 0.42em;

        color: var(--ca-pink);
    }



    /* ============================================================
       CAMPOS DE INVESTIGACIÓN
    ============================================================ */

    .research-fields {
        display: flex;
        align-items: center;
        flex-wrap: wrap;

        gap: 34px;

        font-size: 11px;
        line-height: 1.4;

        letter-spacing: 0.22em;

        color: rgba(245, 245, 245, 0.54);
    }


    .research-fields span {
        position: relative;
    }


    .research-fields span:not(:last-child)::after {
        content: "";

        position: absolute;

        top: 50%;
        right: -18px;

        width: 2px;
        height: 2px;

        border-radius: 50%;

        background: var(--ca-pink);
    }



    /* ============================================================
       TÍTULO
    ============================================================ */

    .hero-title h1 {
        position: relative;

        z-index: 6;

        margin: 0;

        font-size: clamp(
            76px,
            7.2vw,
            118px
        );

        font-weight: 800;

        line-height: 0.79;
        letter-spacing: -0.075em;

        color: var(--ca-white);
    }


    .hero-title h1 span {
        display: block;
    }


    .hero-title h1 span:last-child {
        margin-top: 20px;
    }



    /* ============================================================
       MISIÓN
    ============================================================ */

    .mission {
        width: min(
            620px,
            91%
        );

        margin: 47px 0 0;

        font-size: 16px;
        line-height: 1.8;

        color: rgba(245, 245, 245, 0.59);
    }



    /* ============================================================
       HERO — OBJETO VISUAL
    ============================================================ */

    .hero-visual {
        position: absolute;

        width: clamp(
            520px,
            47vw,
            710px
        );

        aspect-ratio: 1;

        right: -80px;
        top: -38px;

        z-index: 1;

        pointer-events: none;
    }



    /* ============================================================
       HALO
    ============================================================ */

    .visual-glow {
        position: absolute;

        width: 76%;
        height: 76%;

        left: 50%;
        top: 45%;

        transform: translate(
            -50%,
            -50%
        );

        border-radius: 50%;

        background:
            radial-gradient(
                circle,
                rgba(255, 47, 109, 0.17) 0%,
                rgba(255, 47, 109, 0.08) 34%,
                rgba(255, 47, 109, 0.025) 52%,
                transparent 72%
            );

        filter: blur(45px);
    }



    /* ============================================================
       IMAGEN
    ============================================================ */

    .hero-art {
        position: absolute;
        inset: 0;

        width: 100%;
        height: 100%;

        object-fit: contain;

        opacity: 0.69;

        mix-blend-mode: screen;

        filter:
            brightness(0.68)
            contrast(1.12)
            saturate(0.9);

        -webkit-mask-image:
            radial-gradient(
                ellipse at center,
                black 26%,
                rgba(0, 0, 0, 0.98) 50%,
                rgba(0, 0, 0, 0.82) 69%,
                rgba(0, 0, 0, 0.42) 84%,
                transparent 98%
            );

        mask-image:
            radial-gradient(
                ellipse at center,
                black 26%,
                rgba(0, 0, 0, 0.98) 50%,
                rgba(0, 0, 0, 0.82) 69%,
                rgba(0, 0, 0, 0.42) 84%,
                transparent 98%
            );
    }



    /* ============================================================
       FUNDIDO INFERIOR

       Se refuerza para que el texto CRÍTICA ACELERADA
       contenido en el propio gráfico quede como residuo visual
       y no como segundo logotipo.
    ============================================================ */

    .visual-fade {
        position: absolute;
        inset: 0;

        z-index: 2;

        pointer-events: none;

        background:
            linear-gradient(
                to bottom,
                transparent 0%,
                transparent 54%,
                rgba(5, 5, 5, 0.08) 60%,
                rgba(5, 5, 5, 0.30) 68%,
                rgba(5, 5, 5, 0.68) 76%,
                rgba(5, 5, 5, 0.92) 86%,
                #050505 97%
            );
    }



    /* ============================================================
       MICROINTERFAZ
    ============================================================ */

    .system-data {
        position: absolute;

        top: 64px;
        right: 0;

        z-index: 7;

        width: 128px;

        display: flex;
        flex-direction: column;

        gap: 7px;

        font-size: 8px;
        line-height: 1.5;

        letter-spacing: 0.16em;

        color: rgba(245, 245, 245, 0.33);
    }


    .system-code {
        color: var(--ca-pink);
    }


    .system-line {
        width: 100%;
        height: 1px;

        margin: 4px 0 7px;

        background: rgba(255, 47, 109, 0.27);
    }


    .system-data strong {
        font-weight: 500;

        color: var(--ca-pink);
    }


    .system-accent {
        width: 48px;
        height: 2px;

        margin-top: 5px;

        background: var(--ca-pink);
    }



    /* ============================================================
       FRANJA INFERIOR HERO
    ============================================================ */

    .hero-bottom {
        position: relative;

        z-index: 7;

        min-height: 118px;

        display: grid;

        grid-template-columns:
            0.85fr
            1.4fr;

        align-items: center;

        border-top:
            1px solid rgba(255, 47, 109, 0.18);

        border-bottom:
            1px solid rgba(255, 255, 255, 0.07);
    }


    .hero-bottom-block {
        display: flex;
        align-items: center;

        gap: 22px;

        padding: 24px 0;
    }


    .hero-bottom-block + .hero-bottom-block {
        padding-left: 38px;

        border-left:
            1px solid rgba(255, 255, 255, 0.06);
    }


    .hero-bottom-block > div {
        display: flex;
        flex-direction: column;

        gap: 6px;

        font-size: 9px;
        line-height: 1.35;

        letter-spacing: 0.2em;

        color: rgba(245, 245, 245, 0.38);
    }


    .hero-bottom-block strong {
        font-weight: 500;

        color: rgba(255, 47, 109, 0.82);
    }


    .hero-bottom-block i {
        margin-inline: 8px;

        font-style: normal;

        color: var(--ca-pink);
    }



    /* ============================================================
       MARCADOR
    ============================================================ */

    .bottom-marker {
        position: relative;

        width: 58px;
        height: 58px;

        flex: 0 0 auto;

        border:
            1px solid rgba(255, 47, 109, 0.24);

        border-radius: 50%;

        background:
            radial-gradient(
                circle,
                var(--ca-pink) 0 2px,
                transparent 3px
            ),

            linear-gradient(
                rgba(255, 47, 109, 0.18),
                rgba(255, 47, 109, 0.18)
            )
            center / 1px 100%
            no-repeat,

            linear-gradient(
                90deg,
                rgba(255, 47, 109, 0.18),
                rgba(255, 47, 109, 0.18)
            )
            center / 100% 1px
            no-repeat;
    }


    .bottom-marker::after {
        content: "";

        position: absolute;
        inset: 9px;

        border:
            1px solid rgba(255, 47, 109, 0.18);

        border-radius: 50%;
    }



    /* ============================================================
       TRANSICIÓN HERO → MANIFIESTO
    ============================================================ */

    .hero-transition {
        position: relative;

        height: 72px;

        background:
            linear-gradient(
                to bottom,
                #050505,
                #030303
            );
    }


    .transition-inner {
        height: 100%;

        display: grid;

        grid-template-columns:
            auto
            minmax(60px, 1fr)
            auto;

        align-items: center;

        gap: 18px;

        font-size: 7px;
        letter-spacing: 0.25em;

        color: rgba(245, 245, 245, 0.18);
    }


    .transition-inner span:first-child {
        color: rgba(255, 47, 109, 0.48);
    }


    .transition-line {
        height: 1px;

        background:
            linear-gradient(
                90deg,
                rgba(255, 47, 109, 0.18),
                rgba(255, 255, 255, 0.07) 40%,
                transparent 100%
            );
    }



    /* ============================================================
       MANIFIESTO
    ============================================================ */

    .manifest-section {
        position: relative;

        overflow: hidden;

        isolation: isolate;

        border-top:
            1px solid rgba(255, 255, 255, 0.025);

        border-bottom:
            1px solid var(--ca-line);

        background:
            radial-gradient(
                circle at 70% 44%,
                rgba(255, 47, 109, 0.045),
                transparent 38%
            ),
            linear-gradient(
                90deg,
                rgba(255, 47, 109, 0.018),
                transparent 40%
            ),
            #030303;
    }



    /* RETÍCULA PROPIA */

    .manifest-grid {
        position: absolute;
        inset: 0;

        z-index: -2;

        pointer-events: none;

        opacity: 0.5;

        background-image:
            linear-gradient(
                rgba(255, 255, 255, 0.014) 1px,
                transparent 1px
            ),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.014) 1px,
                transparent 1px
            );

        background-size: 42px 42px;

        -webkit-mask-image:
            radial-gradient(
                ellipse at center,
                black,
                transparent 78%
            );

        mask-image:
            radial-gradient(
                ellipse at center,
                black,
                transparent 78%
            );
    }



    /* NÚMERO GIGANTE RESIDUAL */

    .manifest-ghost {
        position: absolute;

        right: 4%;
        top: 50%;

        z-index: -1;

        transform: translateY(-51%);

        font-size: clamp(
            210px,
            25vw,
            390px
        );

        font-weight: 700;

        line-height: 1;

        letter-spacing: -0.09em;

        color: rgba(255, 255, 255, 0.014);

        user-select: none;

        pointer-events: none;
    }



    /* COMPOSICIÓN */

    .manifest-inner {
        position: relative;

        min-height: 460px;

        padding: 132px 0 128px;

        display: grid;

        grid-template-columns:
            185px
            minmax(0, 1fr);

        gap: 70px;

        align-items: start;
    }



    /* ASIDE */

    .manifest-aside {
        display: flex;
        flex-direction: column;

        align-items: flex-start;

        gap: 13px;

        padding-top: 8px;
    }


    .manifest-code {
        font-size: 9px;
        line-height: 1.5;

        letter-spacing: 0.27em;

        color: var(--ca-pink);
    }


    .manifest-index {
        font-size: 7px;
        line-height: 1.5;

        letter-spacing: 0.22em;

        color: rgba(245, 245, 245, 0.26);
    }


    .manifest-aside-line {
        width: 78px;
        height: 1px;

        margin: 8px 0 2px;

        background:
            linear-gradient(
                90deg,
                var(--ca-pink),
                rgba(255, 47, 109, 0)
            );
    }


    .manifest-status {
        font-size: 7px;
        line-height: 1.5;

        letter-spacing: 0.2em;

        color: rgba(245, 245, 245, 0.20);
    }



    /* TEXTO DEL MANIFIESTO */

    .manifest-content {
        max-width: 910px;
    }


    .manifest-intro {
        margin: 0 0 17px;

        font-size: clamp(
            24px,
            2.55vw,
            38px
        );

        font-weight: 400;

        line-height: 1.2;

        letter-spacing: -0.025em;

        color: rgba(245, 245, 245, 0.40);
    }


    .manifest-text {
        max-width: 900px;

        margin: 0;

        font-size: clamp(
            39px,
            4.6vw,
            68px
        );

        font-weight: 650;

        line-height: 1.04;

        letter-spacing: -0.052em;

        color: var(--ca-white);
    }



    /* PIE MANIFIESTO */

    .manifest-bottom {
        margin-top: 47px;

        padding-top: 18px;

        display: flex;
        align-items: center;
        flex-wrap: wrap;

        gap: 15px;

        max-width: 760px;

        border-top:
            1px solid rgba(255, 255, 255, 0.07);

        font-size: 7px;
        line-height: 1.5;

        letter-spacing: 0.22em;

        color: rgba(245, 245, 245, 0.26);
    }


    .manifest-bottom i {
        width: 3px;
        height: 3px;

        border-radius: 50%;

        background: var(--ca-pink);
    }




    /* ============================================================
       REGISTRO MÁS RECIENTE
    ============================================================ */

    .latest-section {
        position: relative;

        overflow: hidden;
        isolation: isolate;

        border-bottom:
            1px solid var(--ca-line);

        background:
            radial-gradient(
                circle at 76% 48%,
                rgba(255, 47, 109, 0.055),
                transparent 36%
            ),
            linear-gradient(
                90deg,
                rgba(255, 47, 109, 0.016),
                transparent 42%
            ),
            #050505;
    }


    .latest-section::before {
        content: "";

        position: absolute;
        inset: 0;

        z-index: -2;

        pointer-events: none;

        opacity: 0.48;

        background-image:
            linear-gradient(
                rgba(255, 255, 255, 0.012) 1px,
                transparent 1px
            ),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.012) 1px,
                transparent 1px
            );

        background-size: 42px 42px;

        -webkit-mask-image:
            radial-gradient(
                ellipse at 67% 50%,
                black,
                transparent 76%
            );

        mask-image:
            radial-gradient(
                ellipse at 67% 50%,
                black,
                transparent 76%
            );
    }


    .latest-ghost {
        position: absolute;

        right: 3%;
        top: 50%;

        z-index: -1;

        transform: translateY(-52%);

        font-size: clamp(
            210px,
            25vw,
            390px
        );

        font-weight: 700;

        line-height: 1;
        letter-spacing: -0.09em;

        color: rgba(255, 255, 255, 0.014);

        user-select: none;
        pointer-events: none;
    }


    .latest-inner {
        position: relative;

        padding: 102px 0 108px;

        display: grid;

        grid-template-columns:
            185px
            minmax(0, 1fr);

        gap: 70px;

        align-items: start;
    }


    /* COLUMNA IZQUIERDA */

    .latest-aside {
        display: flex;
        flex-direction: column;

        align-items: flex-start;

        gap: 13px;

        padding-top: 8px;
    }


    .latest-system-code {
        font-size: 9px;
        line-height: 1.5;

        letter-spacing: 0.27em;

        color: var(--ca-pink);
    }


    .latest-index {
        font-size: 7px;
        line-height: 1.5;

        letter-spacing: 0.22em;

        color: rgba(245, 245, 245, 0.26);
    }


    .latest-aside-line {
        width: 78px;
        height: 1px;

        margin: 8px 0 2px;

        background:
            linear-gradient(
                90deg,
                var(--ca-pink),
                rgba(255, 47, 109, 0)
            );
    }


    .latest-status {
        max-width: 150px;

        font-size: 7px;
        line-height: 1.7;

        letter-spacing: 0.2em;

        color: rgba(245, 245, 245, 0.20);
    }


    /* PUBLICACIÓN */

    .latest-entry {
        position: relative;

        display: block;

        min-width: 0;

        padding: 27px 0 0;

        color: inherit;
        text-decoration: none;

        border-top:
            1px solid rgba(255, 47, 109, 0.72);

        transition:
            padding-left 0.28s ease,
            background 0.28s ease;
    }


    .latest-entry::before {
        content: "";

        position: absolute;

        left: 0;
        top: -1px;

        width: 0;
        height: 1px;

        background: var(--ca-pink);

        box-shadow:
            0 0 18px rgba(255, 47, 109, 0.45);

        transition:
            width 0.45s ease;
    }


    .latest-entry:hover {
        padding-left: 17px;

        background:
            linear-gradient(
                90deg,
                rgba(255, 47, 109, 0.035),
                transparent 58%
            );
    }


    .latest-entry:hover::before {
        width: 100%;
    }


    /* METADATOS */

    .latest-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;

        gap: 12px 28px;

        margin-bottom: 31px;

        font-size: 8px;
        line-height: 1.5;

        letter-spacing: 0.22em;

        color: rgba(245, 245, 245, 0.30);
    }


    .latest-code {
        color: var(--ca-pink);
    }


    .latest-date {
        margin-left: auto;

        color: rgba(245, 245, 245, 0.44);
    }


    /* TÍTULO */

    .latest-entry h2 {
        max-width: 890px;

        margin: 0;

        font-size: clamp(
            40px,
            4.8vw,
            67px
        );

        font-weight: 680;

        line-height: 1.01;

        letter-spacing: -0.052em;

        color: var(--ca-white);

        text-wrap: balance;
    }


    /* DESCRIPCIÓN */

    .latest-description {
        max-width: 760px;

        margin: 27px 0 0;

        font-size: 14px;
        line-height: 1.8;

        color: rgba(245, 245, 245, 0.48);
    }


    /* PIE */

    .latest-footer {
        margin-top: 42px;

        padding: 22px 0 25px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 30px;

        border-top:
            1px solid rgba(255, 255, 255, 0.07);

        border-bottom:
            1px solid rgba(255, 255, 255, 0.07);
    }


    .latest-author {
        font-size: 8px;
        line-height: 1.5;

        letter-spacing: 0.18em;

        text-transform: uppercase;

        color: rgba(245, 245, 245, 0.35);
    }


    .latest-languages {
        display: flex;
        align-items: center;
        flex-wrap: wrap;

        gap: 18px 34px;
    }


    .latest-read {
        display: flex;
        align-items: center;

        gap: 13px;

        font-size: 8px;
        line-height: 1.5;

        letter-spacing: 0.21em;

        color: rgba(245, 245, 245, 0.52);

        text-decoration: none;

        transition:
            color 0.25s ease;
    }


    .latest-read:hover {
        color: var(--ca-white);
    }


    .latest-read i {
        font-size: 22px;
        line-height: 1;

        font-style: normal;

        color: var(--ca-pink);

        transition:
            transform 0.25s ease;
    }


    .latest-read:hover i {
        transform: translateX(7px);
    }


    /* ============================================================
       ARCHIVOS
    ============================================================ */

    .archive-section {
        position: relative;

        padding: 120px 0 135px;

        background: #050505;
    }



    /* ============================================================
       CABECERA
    ============================================================ */

    .archive-header {
        display: flex;

        align-items: flex-end;
        justify-content: space-between;

        gap: 40px;

        margin-bottom: 54px;

        padding-bottom: 28px;

        border-bottom:
            1px solid var(--ca-line);
    }


    .section-eyebrow {
        display: block;

        margin-bottom: 13px;

        font-size: 9px;
        line-height: 1.5;

        letter-spacing: 0.28em;

        color: var(--ca-pink);
    }


    .archive-header h2 {
        margin: 0;

        font-size: clamp(
            42px,
            5vw,
            72px
        );

        line-height: 0.95;

        letter-spacing: -0.06em;

        color: var(--ca-white);
    }


    .archive-count {
        margin-bottom: 6px;

        font-size: 8px;
        line-height: 1.5;

        letter-spacing: 0.22em;

        color: rgba(245, 245, 245, 0.35);
    }



    /* ============================================================
       LISTA
    ============================================================ */

    .portal-list {
        border-top:
            1px solid rgba(255, 47, 109, 0.72);
    }



    /* ============================================================
       FILA
    ============================================================ */

    .portal-row {
        position: relative;

        min-height: 205px;

        display: grid;

        grid-template-columns:
            125px
            minmax(0, 1fr)
            190px;

        align-items: center;

        gap: 30px;

        padding: 32px 12px;

        color: inherit;

        text-decoration: none;

        border-bottom:
            1px solid var(--ca-line);

        transition:
            background 0.25s ease,
            padding-left 0.25s ease;
    }


    .portal-row::before {
        content: "";

        position: absolute;

        left: 0;
        top: 0;

        width: 2px;
        height: 0;

        background: var(--ca-pink);

        transition:
            height 0.25s ease;
    }


    .portal-row:hover {
        padding-left: 22px;

        background:
            linear-gradient(
                90deg,
                rgba(255, 47, 109, 0.058),
                rgba(255, 47, 109, 0.013) 48%,
                transparent
            );
    }


    .portal-row:hover::before {
        height: 100%;
    }



    /* ============================================================
       NÚMERO
    ============================================================ */

    .portal-number {
        font-size: 52px;
        font-weight: 300;

        line-height: 1;

        letter-spacing: -0.05em;

        color: rgba(245, 245, 245, 0.14);

        transition:
            color 0.25s ease;
    }


    .portal-row:hover .portal-number {
        color: var(--ca-pink);
    }



    /* ============================================================
       META
    ============================================================ */

    .portal-meta {
        display: flex;

        gap: 26px;

        margin-bottom: 18px;

        font-size: 8px;
        line-height: 1.5;

        letter-spacing: 0.22em;

        color: rgba(245, 245, 245, 0.34);
    }


    .portal-meta span:first-child {
        color: rgba(255, 47, 109, 0.82);
    }



    /* ============================================================
       TÍTULO PORTAL
    ============================================================ */

    .portal-main h3 {
        margin: 0;

        font-size: clamp(
            29px,
            3vw,
            42px
        );

        font-weight: 700;

        line-height: 1;

        letter-spacing: -0.045em;

        color: var(--ca-white);
    }



    /* ============================================================
       DESCRIPCIÓN
    ============================================================ */

    .portal-main p {
        max-width: 620px;

        margin: 16px 0 0;

        font-size: 13px;
        line-height: 1.7;

        color: rgba(245, 245, 245, 0.47);
    }



    /* ============================================================
       ACCIÓN
    ============================================================ */

    .portal-action {
        justify-self: end;

        display: flex;
        align-items: center;

        gap: 17px;

        font-size: 8px;
        line-height: 1.5;

        letter-spacing: 0.21em;

        color: rgba(245, 245, 245, 0.40);
    }


    .portal-arrow {
        font-size: 22px;
        line-height: 1;

        color: var(--ca-pink);

        transition:
            transform 0.25s ease;
    }


    .portal-row:hover .portal-arrow {
        transform: translateX(7px);
    }



    /* ============================================================
       MICELIO
    ============================================================ */

    .mycelium-section {
        position: relative;

        padding: 122px 0 142px;

        overflow: hidden;
        isolation: isolate;

        border-top:
            1px solid rgba(255, 255, 255, 0.035);

        background:
            radial-gradient(
                circle at 72% 42%,
                rgba(255, 47, 109, 0.055),
                transparent 38%
            ),
            linear-gradient(
                90deg,
                rgba(255, 47, 109, 0.018),
                transparent 46%
            ),
            #030303;
    }


    .mycelium-grid-background {
        position: absolute;
        inset: 0;

        z-index: -2;

        pointer-events: none;

        opacity: 0.48;

        background-image:
