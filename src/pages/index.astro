
---
import "../styles/global.css";
import SocialFooter from "../components/SocialFooter.astro";
---


<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crítica Acelerada</title>
</head>

<body>

<main class="hero">

    <div class="container hero-grid">

        <div class="hero-meta">

            <p class="eyebrow">
                LABORATORIO DE ESTUDIOS CRÍTICOS
            </p>

            <div class="research-fields">
                <span>ACELERACIONISMO</span>
                <span>COLAPSO</span>
                <span>RIESGOS EXISTENCIALES</span>
            </div>

        </div>

        <img
            src="/images/logo.png"
            alt="Crítica Acelerada"
            class="logo"
        />

        <div class="hero-title">

            <h1>
                <span>CRÍTICA</span>
                <span>ACELERADA</span>
            </h1>

            <p class="mission">
                Impensar las categorías heredadas para comprender las transformaciones tecnológicas, económicas y filosóficas del presente.
            </p>

        </div>

    </div>

</main>

<section class="archive portals">

    <div class="container portal-grid">

    <a href="/expedientes" class="portal-card">

        <div class="portal-top">
            <span class="portal-code">CA / 01</span>
            <span class="portal-status">ARCHIVO TEXTUAL</span>
        </div>

        <div class="portal-content">

            <h2>EXPEDIENTES</h2>

            <p>
                Ensayos, investigaciones y documentos críticos sobre
                aceleracionismo, colapso y riesgos existenciales.
            </p>

        </div>

        <span class="read-link">
            Entrar al archivo →
        </span>

    </a>

    <a href="/transmisiones" class="portal-card">

        <div class="portal-top">
            <span class="portal-code">CA / 02</span>
            <span class="portal-status">ARCHIVO AUDIOVISUAL</span>
        </div>

        <div class="portal-content">

            <h2>TRANSMISIONES</h2>

            <p>
                Videos, monólogos, conversaciones y registros
                audiovisuales producidos por el laboratorio.
            </p>

        </div>

        <span class="read-link">
            Acceder a transmisiones →
        </span>

    </a>

    <a href="/destilados" class="portal-card">

        <div class="portal-top">
            <span class="portal-code">CA / 03</span>
            <span class="portal-status">ARCHIVO DESTILADO</span>
        </div>

        <div class="portal-content">

            <h2>DESTILADOS</h2>

            <p>
                Síntesis críticas de libros, artículos y textos fundamentales
                para comprender el aceleracionismo, el colapso y los riesgos
                existenciales.
            </p>

        </div>

        <span class="read-link">
            Explorar destilados →
        </span>

    </a>

</div>

</section>

<SocialFooter />

</body>

</html>