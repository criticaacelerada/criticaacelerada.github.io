---
import "../styles/global.css";
import SocialFooter from "../components/SocialFooter.astro";
---

<!doctype html>
<html lang="es">

<head>
    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <meta
        name="description"
        content="Crítica Acelerada — Laboratorio de Estudios Críticos sobre Aceleracionismo, Colapso y Riesgos Existenciales."
    />

    <meta
        name="theme-color"
        content="#050505"
    />

    <title>Crítica Acelerada</title>
</head>

<body>

    <main class="home">

        <!-- =====================================================
             HERO
        ====================================================== -->

        <section class="home-hero">

            <!-- RETÍCULA -->
            <div
                class="hero-grid-background"
                aria-hidden="true"
            ></div>

            <!-- MARCAS DE ENCUADRE -->
            <div
                class="hero-frame"
                aria-hidden="true"
            >
                <span class="corner corner-tl"></span>
                <span class="corner corner-tr"></span>
                <span class="corner corner-bl"></span>
                <span class="corner corner-br"></span>
            </div>


            <!-- CONTENIDO PRINCIPAL -->
            <div class="home-container hero-layout">

                <!-- IZQUIERDA -->
                <div class="hero-copy">

                    <div class="hero-meta">

                        <p class="eyebrow">
                            LABORATORIO DE ESTUDIOS CRÍTICOS
                        </p>

                        <div class="research-fields">
                            <span>ACELERACIONISMO</span>
                            <span>COLAPSO</span>
                            <span>RIESGOS EXISTENCIALES</span>
                        </div>

                    </div>

                    <div class="hero-title">

                        <h1>
                            <span>CRÍTICA</span>
                            <span>ACELERADA</span>
                        </h1>

                        <p class="mission">
                            Impensar las categorías heredadas para comprender
                            las transformaciones tecnológicas, económicas y
                            filosóficas del presente.
                        </p>

                    </div>

                </div>


                <!-- OBJETO VISUAL -->
                <div
                    class="hero-visual"
                    aria-hidden="true"
                >

                    <div class="visual-glow"></div>

                    <img
                        src="/images/ca-home-visual.jpeg"
                        alt=""
                        class="hero-art"
                    />

                    <div class="visual-fade"></div>

                </div>


                <!-- DATOS LATERALES -->
                <div
                    class="system-data"
                    aria-hidden="true"
                >

                    <span class="system-code">
                        CA-LAB // 001
                    </span>

                    <div class="system-line"></div>

                    <span>
                        ARCHIVO LIBERADO
                    </span>

                    <span>
                        NIVEL DE ACCESO
                    </span>

                    <strong>
                        PÚBLICO
                    </strong>

                    <div class="system-accent"></div>

                </div>

            </div>


            <!-- FRANJA INFERIOR -->
            <div class="home-container hero-bottom">

                <div class="hero-bottom-block">

                    <span
                        class="bottom-marker"
                        aria-hidden="true"
                    ></span>

                    <div>

                        <strong>
                            INVESTIGACIÓN INDEPENDIENTE
                        </strong>

                        <span>
                            PENSAMIENTO CRÍTICO
                        </span>

                        <span>
                            FUTUROS POSIBLES
                        </span>

                    </div>

                </div>


                <div class="hero-bottom-block hero-bottom-archive">

                    <div>

                        <strong>
                            ARCHIVOS DEL LABORATORIO
                        </strong>

                        <span>
                            DOCUMENTOS
                            <i>›</i>
                            ANÁLISIS
                            <i>›</i>
                            TRANSMISIONES
                            <i>›</i>
                            ARCHIVO
                        </span>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             TRANSICIÓN
        ====================================================== -->

        <div class="hero-transition" aria-hidden="true">

            <div class="home-container transition-inner">

                <span>CA / TRANSICIÓN</span>

                <div class="transition-line"></div>

                <span>001</span>

            </div>

        </div>


        <!-- =====================================================
             MANIFIESTO
        ====================================================== -->

        <section class="manifest-section">

            <div
                class="manifest-grid"
                aria-hidden="true"
            ></div>

            <div
                class="manifest-ghost"
                aria-hidden="true"
            >
                01
            </div>


            <div class="home-container manifest-inner">


                <!-- COLUMNA IZQUIERDA -->
                <aside class="manifest-aside">

                    <span class="manifest-code">
                        CA / SISTEMA
                    </span>

                    <span class="manifest-index">
                        DECLARACIÓN / 001
                    </span>

                    <div class="manifest-aside-line"></div>

                    <span class="manifest-status">
                        PENSAMIENTO CRÍTICO
                    </span>

                </aside>


                <!-- TEXTO -->
                <div class="manifest-content">

                    <p class="manifest-intro">
                        NO INVESTIGAMOS LO OCULTO;
                    </p>

                    <p class="manifest-text">
                        INVESTIGAMOS AQUELLO QUE AÚN NO HA SIDO
                        PENSADO CON SUFICIENTE RIGOR.
                    </p>


                    <div
                        class="manifest-bottom"
                        aria-hidden="true"
                    >

                        <span>
                            ACELERACIONISMO
                        </span>

                        <i></i>

                        <span>
                            COLAPSO
                        </span>

                        <i></i>

                        <span>
                            RIESGOS EXISTENCIALES
                        </span>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             ARCHIVOS
        ====================================================== -->

        <section class="archive-section">

            <div class="home-container">


                <!-- CABECERA -->
                <header class="archive-header">

                    <div>

                        <span class="section-eyebrow">
                            ESTRUCTURA DEL LABORATORIO
                        </span>

                        <h2>
                            ARCHIVOS
                        </h2>

                    </div>

                    <span class="archive-count">
                        03 NODOS ACTIVOS
                    </span>

                </header>


                <!-- LISTA -->
                <div class="portal-list">


                    <!-- EXPEDIENTES -->
                    <a
                        href="/expedientes"
                        class="portal-row"
                    >

                        <div class="portal-number">
                            01
                        </div>


                        <div class="portal-main">

                            <div class="portal-meta">

                                <span>
                                    CA / 01
                                </span>

                                <span>
                                    ARCHIVO TEXTUAL
                                </span>

                            </div>


                            <h3>
                                EXPEDIENTES
                            </h3>


                            <p>
                                Ensayos, investigaciones y documentos críticos
                                sobre aceleracionismo, colapso y riesgos
                                existenciales.
                            </p>

                        </div>


                        <div class="portal-action">

                            <span>
                                ENTRAR AL ARCHIVO
                            </span>

                            <span class="portal-arrow">
                                →
                            </span>

                        </div>

                    </a>


                    <!-- TRANSMISIONES -->
                    <a
                        href="/transmisiones"
                        class="portal-row"
                    >

                        <div class="portal-number">
                            02
                        </div>


                        <div class="portal-main">

                            <div class="portal-meta">

                                <span>
                                    CA / 02
                                </span>

                                <span>
                                    ARCHIVO AUDIOVISUAL
                                </span>

                            </div>


                            <h3>
                                TRANSMISIONES
                            </h3>


                            <p>
                                Videos, monólogos, conversaciones y registros
                                audiovisuales producidos por el laboratorio.
                            </p>

                        </div>


                        <div class="portal-action">

                            <span>
                                ACCEDER
                            </span>

                            <span class="portal-arrow">
                                →
                            </span>

                        </div>

                    </a>


                    <!-- DESTILADOS -->
                    <a
                        href="/destilados"
                        class="portal-row"
                    >

                        <div class="portal-number">
                            03
                        </div>


                        <div class="portal-main">

                            <div class="portal-meta">

                                <span>
                                    CA / 03
                                </span>

                                <span>
                                    ARCHIVO DESTILADO
                                </span>

                            </div>


                            <h3>
                                DESTILADOS
                            </h3>


                            <p>
                                Síntesis críticas de libros, artículos y textos
                                fundamentales para comprender el aceleracionismo,
                                el colapso y los riesgos existenciales.
                            </p>

                        </div>


                        <div class="portal-action">

                            <span>
                                EXPLORAR
                            </span>

                            <span class="portal-arrow">
                                →
                            </span>

                        </div>

                    </a>

                </div>

            </div>

        </section>

    </main>


    <SocialFooter />

</body>

</html>


<style>

    /* ============================================================
       BASE
    ============================================================ */

    .home {
        --ca-black: #050505;
        --ca-black-deep: #020202;
        --ca-surface: #0a0a0a;

        --ca-white: #f5f5f5;
        --ca-grey: rgba(245, 245, 245, 0.56);
        --ca-muted: rgba(245, 245, 245, 0.28);
        --ca-line: rgba(245, 245, 245, 0.12);

        --ca-pink: #ff2f6d;

        background: var(--ca-black);
        color: var(--ca-white);

        overflow: hidden;
    }


    .home-container {
        width: min(
            1200px,
            calc(100% - 80px)
        );

        margin-inline: auto;
    }



    /* ============================================================
       HERO
    ============================================================ */

    .home-hero {
        position: relative;

        min-height: 790px;

        padding-top: 72px;

        overflow: hidden;
        isolation: isolate;

        background:
            radial-gradient(
                circle at 76% 40%,
                rgba(255, 47, 109, 0.045),
                transparent 34%
            ),
            #050505;
    }



    /* ============================================================
       RETÍCULA
    ============================================================ */

    .hero-grid-background {
        position: absolute;
        inset: 0;

        z-index: -3;

        pointer-events: none;

        background-image:
            linear-gradient(
                rgba(255, 255, 255, 0.018) 1px,
                transparent 1px
            ),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.018) 1px,
                transparent 1px
            );

        background-size: 42px 42px;

        -webkit-mask-image:
            linear-gradient(
                to bottom,
                rgba(0, 0, 0, 0.9),
                rgba(0, 0, 0, 0.55) 68%,
                transparent 100%
            );

        mask-image:
            linear-gradient(
                to bottom,
                rgba(0, 0, 0, 0.9),
                rgba(0, 0, 0, 0.55) 68%,
                transparent 100%
            );
    }



    /* ============================================================
       MARCAS DE ENCUADRE
    ============================================================ */

    .hero-frame {
        position: absolute;
        inset: 31px;

        z-index: 8;

        pointer-events: none;
    }


    .corner {
        position: absolute;

        width: 26px;
        height: 26px;

        opacity: 0.68;
    }


    .corner-tl {
        top: 0;
        left: 0;

        border-top: 1px solid var(--ca-pink);
        border-left: 1px solid var(--ca-pink);
    }


    .corner-tr {
        top: 0;
        right: 0;

        border-top: 1px solid var(--ca-pink);
        border-right: 1px solid var(--ca-pink);
    }


    .corner-bl {
        bottom: 0;
        left: 0;

        border-bottom: 1px solid var(--ca-pink);
        border-left: 1px solid var(--ca-pink);
    }


    .corner-br {
        bottom: 0;
        right: 0;

        border-bottom: 1px solid var(--ca-pink);
        border-right: 1px solid var(--ca-pink);
    }



    /* ============================================================
       HERO — COMPOSICIÓN
    ============================================================ */

    .hero-layout {
        position: relative;

        min-height: 575px;

        display: flex;
        align-items: flex-start;
    }



    /* ============================================================
       HERO — COPY
    ============================================================ */

    .hero-copy {
        position: relative;
        z-index: 5;

        width: 67%;

        padding-top: 8px;
    }


    .hero-meta {
        margin-bottom: 57px;
    }


    .eyebrow {
        margin: 0 0 25px;

        font-size: 12px;
        line-height: 1.4;
        font-weight: 500;

        letter-spacing: 0.42em;

        color: var(--ca-pink);
    }



    /* ============================================================
       CAMPOS DE INVESTIGACIÓN
    ============================================================ */

    .research-fields {
        display: flex;
        align-items: center;
        flex-wrap: wrap;

        gap: 34px;

        font-size: 11px;
        line-height: 1.4;

        letter-spacing: 0.22em;

        color: rgba(245, 245, 245, 0.54);
    }


    .research-fields span {
        position: relative;
    }


    .research-fields span:not(:last-child)::after {
        content: "";

        position: absolute;

        top: 50%;
        right: -18px;

        width: 2px;
        height: 2px;

        border-radius: 50%;

        background: var(--ca-pink);
    }



    /* ============================================================
       TÍTULO
    ============================================================ */

    .hero-title h1 {
        position: relative;

        z-index: 6;

        margin: 0;

        font-size: clamp(
            76px,
            7.2vw,
            118px
        );

        font-weight: 800;

        line-height: 0.79;
        letter-spacing: -0.075em;

        color: var(--ca-white);
    }


    .hero-title h1 span {
        display: block;
    }


    .hero-title h1 span:last-child {
        margin-top: 20px;
    }



    /* ============================================================
       MISIÓN
    ============================================================ */

    .mission {
        width: min(
            620px,
            91%
        );

        margin: 47px 0 0;

        font-size: 16px;
        line-height: 1.8;

        color: rgba(245, 245, 245, 0.59);
    }



    /* ============================================================
       HERO — OBJETO VISUAL
    ============================================================ */

    .hero-visual {
        position: absolute;

        width: clamp(
            520px,
            47vw,
            710px
        );

        aspect-ratio: 1;

        right: -80px;
        top: -38px;

        z-index: 1;

        pointer-events: none;
    }



    /* ============================================================
       HALO
    ============================================================ */

    .visual-glow {
        position: absolute;

        width: 76%;
        height: 76%;

        left: 50%;
        top: 45%;

        transform: translate(
            -50%,
            -50%
        );

        border-radius: 50%;

        background:
            radial-gradient(
                circle,
                rgba(255, 47, 109, 0.17) 0%,
                rgba(255, 47, 109, 0.08) 34%,
                rgba(255, 47, 109, 0.025) 52%,
                transparent 72%
            );

        filter: blur(45px);
    }



    /* ============================================================
       IMAGEN
    ============================================================ */

    .hero-art {
        position: absolute;
        inset: 0;

        width: 100%;
        height: 100%;

        object-fit: contain;

        opacity: 0.69;

        mix-blend-mode: screen;

        filter:
            brightness(0.68)
            contrast(1.12)
            saturate(0.9);

        -webkit-mask-image:
            radial-gradient(
                ellipse at center,
                black 26%,
                rgba(0, 0, 0, 0.98) 50%,
                rgba(0, 0, 0, 0.82) 69%,
                rgba(0, 0, 0, 0.42) 84%,
                transparent 98%
            );

        mask-image:
            radial-gradient(
                ellipse at center,
                black 26%,
                rgba(0, 0, 0, 0.98) 50%,
                rgba(0, 0, 0, 0.82) 69%,
                rgba(0, 0, 0, 0.42) 84%,
                transparent 98%
            );
    }



    /* ============================================================
       FUNDIDO INFERIOR

       Se refuerza para que el texto CRÍTICA ACELERADA
       contenido en el propio gráfico quede como residuo visual
       y no como segundo logotipo.
    ============================================================ */

    .visual-fade {
        position: absolute;
        inset: 0;

        z-index: 2;

        pointer-events: none;

        background:
            linear-gradient(
                to bottom,
                transparent 0%,
                transparent 54%,
                rgba(5, 5, 5, 0.08) 60%,
                rgba(5, 5, 5, 0.30) 68%,
                rgba(5, 5, 5, 0.68) 76%,
                rgba(5, 5, 5, 0.92) 86%,
                #050505 97%
            );
    }



    /* ============================================================
       MICROINTERFAZ
    ============================================================ */

    .system-data {
        position: absolute;

        top: 64px;
        right: 0;

        z-index: 7;

        width: 128px;

        display: flex;
        flex-direction: column;

        gap: 7px;

        font-size: 8px;
        line-height: 1.5;

        letter-spacing: 0.16em;

        color: rgba(245, 245, 245, 0.33);
    }


    .system-code {
        color: var(--ca-pink);
    }


    .system-line {
        width: 100%;
        height: 1px;

        margin: 4px 0 7px;

        background: rgba(255, 47, 109, 0.27);
    }


    .system-data strong {
        font-weight: 500;

        color: var(--ca-pink);
    }


    .system-accent {
        width: 48px;
        height: 2px;

        margin-top: 5px;

        background: var(--ca-pink);
    }



    /* ============================================================
       FRANJA INFERIOR HERO
    ============================================================ */

    .hero-bottom {
        position: relative;

        z-index: 7;

        min-height: 118px;

        display: grid;

        grid-template-columns:
            0.85fr
            1.4fr;

        align-items: center;

        border-top:
            1px solid rgba(255, 47, 109, 0.18);

        border-bottom:
            1px solid rgba(255, 255, 255, 0.07);
    }


    .hero-bottom-block {
        display: flex;
        align-items: center;

        gap: 22px;

        padding: 24px 0;
    }


    .hero-bottom-block + .hero-bottom-block {
        padding-left: 38px;

        border-left:
            1px solid rgba(255, 255, 255, 0.06);
    }


    .hero-bottom-block > div {
        display: flex;
        flex-direction: column;

        gap: 6px;

        font-size: 9px;
        line-height: 1.35;

        letter-spacing: 0.2em;

        color: rgba(245, 245, 245, 0.38);
    }


    .hero-bottom-block strong {
        font-weight: 500;

        color: rgba(255, 47, 109, 0.82);
    }


    .hero-bottom-block i {
        margin-inline: 8px;

        font-style: normal;

        color: var(--ca-pink);
    }



    /* ============================================================
       MARCADOR
    ============================================================ */

    .bottom-marker {
        position: relative;

        width: 58px;
        height: 58px;

        flex: 0 0 auto;

        border:
            1px solid rgba(255, 47, 109, 0.24);

        border-radius: 50%;

        background:
            radial-gradient(
                circle,
                var(--ca-pink) 0 2px,
                transparent 3px
            ),

            linear-gradient(
                rgba(255, 47, 109, 0.18),
                rgba(255, 47, 109, 0.18)
            )
            center / 1px 100%
            no-repeat,

            linear-gradient(
                90deg,
                rgba(255, 47, 109, 0.18),
                rgba(255, 47, 109, 0.18)
            )
            center / 100% 1px
            no-repeat;
    }


    .bottom-marker::after {
        content: "";

        position: absolute;
        inset: 9px;

        border:
            1px solid rgba(255, 47, 109, 0.18);

        border-radius: 50%;
    }



    /* ============================================================
       TRANSICIÓN HERO → MANIFIESTO
    ============================================================ */

    .hero-transition {
        position: relative;

        height: 72px;

        background:
            linear-gradient(
                to bottom,
                #050505,
                #030303
            );
    }


    .transition-inner {
        height: 100%;

        display: grid;

        grid-template-columns:
            auto
            minmax(60px, 1fr)
            auto;

        align-items: center;

        gap: 18px;

        font-size: 7px;
        letter-spacing: 0.25em;

        color: rgba(245, 245, 245, 0.18);
    }


    .transition-inner span:first-child {
        color: rgba(255, 47, 109, 0.48);
    }


    .transition-line {
        height: 1px;

        background:
            linear-gradient(
                90deg,
                rgba(255, 47, 109, 0.18),
                rgba(255, 255, 255, 0.07) 40%,
                transparent 100%
            );
    }



    /* ============================================================
       MANIFIESTO
    ============================================================ */

    .manifest-section {
        position: relative;

        overflow: hidden;

        isolation: isolate;

        border-top:
            1px solid rgba(255, 255, 255, 0.025);

        border-bottom:
            1px solid var(--ca-line);

        background:
            radial-gradient(
                circle at 70% 44%,
                rgba(255, 47, 109, 0.045),
                transparent 38%
            ),
            linear-gradient(
                90deg,
                rgba(255, 47, 109, 0.018),
                transparent 40%
            ),
            #030303;
    }



    /* RETÍCULA PROPIA */

    .manifest-grid {
        position: absolute;
        inset: 0;

        z-index: -2;

        pointer-events: none;

        opacity: 0.5;

        background-image:
            linear-gradient(
                rgba(255, 255, 255, 0.014) 1px,
                transparent 1px
            ),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.014) 1px,
                transparent 1px
            );

        background-size: 42px 42px;

        -webkit-mask-image:
            radial-gradient(
                ellipse at center,
                black,
                transparent 78%
            );

        mask-image:
            radial-gradient(
                ellipse at center,
                black,
                transparent 78%
            );
    }



    /* NÚMERO GIGANTE RESIDUAL */

    .manifest-ghost {
        position: absolute;

        right: 4%;
        top: 50%;

        z-index: -1;

        transform: translateY(-51%);

        font-size: clamp(
            210px,
            25vw,
            390px
        );

        font-weight: 700;

        line-height: 1;

        letter-spacing: -0.09em;

        color: rgba(255, 255, 255, 0.014);

        user-select: none;

        pointer-events: none;
    }



    /* COMPOSICIÓN */

    .manifest-inner {
        position: relative;

        min-height: 460px;

        padding: 132px 0 128px;

        display: grid;

        grid-template-columns:
            185px
            minmax(0, 1fr);

        gap: 70px;

        align-items: start;
    }



    /* ASIDE */

    .manifest-aside {
        display: flex;
        flex-direction: column;

        align-items: flex-start;

        gap: 13px;

        padding-top: 8px;
    }


    .manifest-code {
        font-size: 9px;
        line-height: 1.5;

        letter-spacing: 0.27em;

        color: var(--ca-pink);
    }


    .manifest-index {
        font-size: 7px;
        line-height: 1.5;

        letter-spacing: 0.22em;

        color: rgba(245, 245, 245, 0.26);
    }


    .manifest-aside-line {
        width: 78px;
        height: 1px;

        margin: 8px 0 2px;

        background:
            linear-gradient(
                90deg,
                var(--ca-pink),
                rgba(255, 47, 109, 0)
            );
    }


    .manifest-status {
        font-size: 7px;
        line-height: 1.5;

        letter-spacing: 0.2em;

        color: rgba(245, 245, 245, 0.20);
    }



    /* TEXTO DEL MANIFIESTO */

    .manifest-content {
        max-width: 910px;
    }


    .manifest-intro {
        margin: 0 0 17px;

        font-size: clamp(
            24px,
            2.55vw,
            38px
        );

        font-weight: 400;

        line-height: 1.2;

