---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import heroVisual from "../assets/images/logoca.png";
import { getCollection } from "astro:content";
import { avisos } from "../data/avisos";
import { nodes } from "../data/nodos";
import { getNodeTraces } from "../lib/trazas";
import { formatShortDate } from "../lib/editorial";

const [ensayosTodos, transmisiones, destiladosTodos, alicuotasTodos] =
  await Promise.all([
    getCollection("ensayos"),
    getCollection("transmisiones"),
    getCollection("destilados"),
    getCollection("alicuotas"),
  ]);

const ensayos = ensayosTodos.filter((entry) => entry.data.language === "es");
const destilados = destiladosTodos.filter(
  (entry) => entry.data.language === "es"
);
const alicuotas = alicuotasTodos.filter(
  (entry) => entry.data.language === "es"
);

const publicaciones = [
  ...ensayos.flatMap((entry) => {
    const traduccionEn = entry.data.translationKey
      ? ensayosTodos.find(
          (candidate) =>
            candidate.data.language === "en" &&
            candidate.data.translationKey === entry.data.translationKey
        )
      : undefined;

    const expediente = {
      id: entry.id,
      codigo: `EXPEDIENTE ${String(entry.data.expediente).padStart(3, "0")}`,
      tipo: "ARCHIVO TEXTUAL",
      esTransmision: false,
      fecha: entry.data.date,
      titulo: entry.data.title,
      descripcion: entry.data.descripcion,
      autor: entry.data.author ?? "CRÍTICA ACELERADA",
      hrefEs: `/expedientes/${entry.id}`,
      hrefEn: traduccionEn ? `/expedientes/${traduccionEn.id}` : null,
    };

    if (!entry.data.video) {
      return [expediente];
    }

    const audiovisual = {
      id: `${entry.id}-audiovisual`,
      codigo: `ARCHIVO AUDIOVISUAL / ${String(entry.data.expediente).padStart(3, "0")}`,
      tipo: "MATERIAL ASOCIADO",
      esTransmision: false,
      fecha: entry.data.video.date,
      titulo: entry.data.video.title,
      descripcion: "Material audiovisual asociado a este expediente.",
      autor: entry.data.author ?? "CRÍTICA ACELERADA",
      hrefEs: `/expedientes/${entry.id}`,
      hrefEn: traduccionEn ? `/expedientes/${traduccionEn.id}` : null,
    };

    return [expediente, audiovisual];
  }),

  ...transmisiones.map((entry) => ({
    id: entry.id,
    codigo: `TRANSMISIÓN ${String(entry.data.numero).padStart(3, "0")}`,
    tipo: "ARCHIVO AUDIOVISUAL",
    esTransmision: true,
    fecha: entry.data.pubDate,
    titulo: entry.data.title,
    descripcion: entry.data.description,
    autor: "CRÍTICA ACELERADA",
    hrefEs: `/transmisiones/${entry.id}`,
    hrefEn: null,
  })),

  ...destilados.map((entry) => {
    const traduccionEn = entry.data.translationKey
      ? destiladosTodos.find(
          (candidate) =>
            candidate.data.language === "en" &&
            candidate.data.translationKey === entry.data.translationKey
        )
      : undefined;

    return {
      id: entry.id,
      codigo: `DESTILADO ${String(entry.data.numero).padStart(3, "0")}`,
      tipo: "ARCHIVO DESTILADO",
      esTransmision: false,
      fecha: entry.data.pubDate,
      titulo: entry.data.title,
      descripcion: entry.data.description,
      autor: entry.data.autor,
      hrefEs: `/destilados/${entry.id}`,
      hrefEn: traduccionEn ? `/destilados/${traduccionEn.id}` : null,
    };
  }),

  ...alicuotas.map((entry) => {
    const traduccionEn = entry.data.translationKey
      ? alicuotasTodos.find(
          (candidate) =>
            candidate.data.language === "en" &&
            candidate.data.translationKey === entry.data.translationKey
        )
      : undefined;

    return {
      id: entry.id,
      codigo: `AE—${String(entry.data.numero).padStart(3, "0")}`,
      tipo: "ARCHIVO EXPERIMENTAL",
      esTransmision: false,
      fecha: entry.data.pubDate,
      titulo: entry.data.title,
      descripcion: entry.data.description,
      autor: entry.data.autor,
      hrefEs: `/alicuotas/${entry.id}`,
      hrefEn: traduccionEn ? `/alicuotas/${traduccionEn.id}` : null,
    };
  }),
];

const masReciente = publicaciones.sort(
  (a, b) => b.fecha.getTime() - a.fecha.getTime()
)[0];

const etiquetaAccionPrincipal = masReciente?.esTransmision
  ? "IR A LA TRANSMISIÓN"
  : "LEER EN ESPAÑOL";

const ariaAccionPrincipal = masReciente
  ? masReciente.esTransmision
    ? `Ir a la transmisión ${masReciente.titulo}`
    : `Leer ${masReciente.titulo} en español`
  : "";

const avisosActivos = avisos
  .filter((aviso) => aviso.activo)
  .sort((a, b) => b.fecha.getTime() - a.fecha.getTime())
  .slice(0, 3);

const nodosConTrazas = await Promise.all(
  nodes.map(async (node) => {
    const traces = await getNodeTraces(node);
    return {
      node,
      traceCount: traces.length,
    };
  })
);

const totalExpedientes = new Set(
  ensayosTodos.map((e) => e.data.translationKey ?? e.id)
).size;
const totalDestilados = new Set(
  destiladosTodos.map((d) => d.data.translationKey ?? d.id)
).size;
const totalAlicuotas = new Set(
  alicuotasTodos.map((a) => a.data.translationKey ?? a.id)
).size;
---

<BaseLayout
  title="Crítica Acelerada"
  description="Crítica Acelerada — Laboratorio de Economía Política y Filosofía del Capitalismo Contemporáneo."
  lang="es"
>
  <main class="home">
    <!-- =====================================================
         HERO EDITORIAL
    ====================================================== -->
    <section class="home-hero">
      <div class="container hero-layout">
        <div class="hero-copy">
          <div class="hero-meta">
            <p class="eyebrow">LABORATORIO DE ESTUDIOS CRÍTICOS</p>

            <div class="research-fields">
              <span>ECONOMÍA POLÍTICA</span>
              <span>FILOSOFÍA</span>
              <span>CAPITALISMO CONTEMPORÁNEO</span>
            </div>
          </div>

          <div class="hero-title">
            <h1>
              <span>Crítica</span>
              <span>Acelerada</span>
            </h1>

            <p class="mission">
              Impensar las categorías heredadas para comprender las
              transformaciones tecnológicas, económicas y filosóficas del
              presente.
            </p>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <Image
            src={heroVisual}
            alt=""
            class="hero-art"
            widths={[440, 760]}
            sizes="(max-width: 960px) 0px, 440px"
            format="webp"
            quality={86}
            loading="eager"
            fetchpriority="high"
          />
          <div class="visual-fade"></div>
        </div>
      </div>

      <div class="container hero-bottom">
        <div class="hero-bottom-block">
          <span class="hero-bottom-kicker">CA-LAB // ARCHIVO ABIERTO</span>
          <span class="hero-bottom-detail">
            INVESTIGACIÓN INDEPENDIENTE · PENSAMIENTO CRÍTICO
          </span>
        </div>

        <div class="hero-bottom-block hero-bottom-right">
          <span class="hero-bottom-kicker">PRODUCCIÓN ACTIVA</span>
          <span class="hero-bottom-detail">
            {String(totalExpedientes).padStart(2, "0")} EXPEDIENTES ·{" "}
            {String(transmisiones.length).padStart(2, "0")} TRANSMISIONES ·{" "}
            {String(totalDestilados).padStart(2, "0")} DESTILADOS ·{" "}
            {String(totalAlicuotas).padStart(2, "0")} ALÍCUOTAS
          </span>
        </div>
      </div>
    </section>

    <!-- =====================================================
         REGISTRO MÁS RECIENTE (LEAD STORY)
    ====================================================== -->
    {
      masReciente && (
        <section class="latest-section">
          <div class="container latest-inner">
            <aside class="section-aside-col">
              <span class="aside-code">CA / REGISTRO</span>
              <span class="aside-index">PUBLICACIÓN MÁS RECIENTE</span>
              <div class="aside-rule" aria-hidden="true" />
              <time
                class="aside-date"
                datetime={masReciente.fecha.toISOString().slice(0, 10)}
              >
                {formatShortDate(masReciente.fecha)}
              </time>
            </aside>

            <article class="latest-entry">
              <div class="latest-meta">
                <span class="latest-code">{masReciente.codigo}</span>
                <span>{masReciente.tipo}</span>
                <span class="latest-author">{masReciente.autor}</span>
              </div>

              <h2>
                <a href={masReciente.hrefEs}>{masReciente.titulo}</a>
              </h2>

              <p class="latest-description">{masReciente.descripcion}</p>

              <div class="latest-footer">
                <div
                  class="latest-languages"
                  aria-label={
                    masReciente.esTransmision
                      ? "Acceso a la transmisión"
                      : "Idiomas disponibles"
                  }
                >
                  <a
                    class="latest-read"
                    href={masReciente.hrefEs}
                    aria-label={ariaAccionPrincipal}
                  >
                    <span>{etiquetaAccionPrincipal}</span>
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>

                  {masReciente.hrefEn && (
                    <a
                      class="latest-read is-secondary"
                      href={masReciente.hrefEn}
                      aria-label={`Read ${masReciente.titulo} in English`}
                    >
                      <span>READ IN ENGLISH</span>
                      <span class="arrow" aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          </div>
        </section>
      )
    }

    <!-- =====================================================
         MANIFIESTO
    ====================================================== -->
    <section class="manifest-section">
      <div class="container manifest-inner">
        <aside class="section-aside-col">
          <span class="aside-code">CA / MANIFIESTO</span>
          <span class="aside-index">DECLARACIÓN 001</span>
          <div class="aside-rule" aria-hidden="true"></div>
        </aside>

        <div class="manifest-content">
          <p class="manifest-intro">No investigamos lo oculto;</p>
          <p class="manifest-text">
            investigamos aquello que aún no ha sido pensado con suficiente
            rigor.
          </p>
        </div>
      </div>
    </section>

    <!-- =====================================================
         ARCHIVOS
    ====================================================== -->
    <section class="archive-section" id="archivos">
      <div class="container">
        <header class="section-header">
          <div>
            <span class="eyebrow">ESTRUCTURA DEL LABORATORIO</span>
            <h2>Archivos</h2>
          </div>
          <span class="section-count">04 ARCHIVOS ACTIVOS</span>
        </header>

        <div class="portal-list">
          <a href="/expedientes" class="portal-row">
            <div class="portal-number">01</div>
            <div class="portal-main">
              <div class="portal-meta">
                <span>CA / 01</span>
                <span>ARCHIVO TEXTUAL</span>
                <span>{String(totalExpedientes).padStart(2, "0")} DOCUMENTOS</span>
              </div>
              <h3>Expedientes</h3>
              <p>
                Ensayos, investigaciones y traducciones críticas para analizar
                las transformaciones del capitalismo contemporáneo.
              </p>
            </div>
            <div class="portal-action">
              <span>ENTRAR</span>
              <span class="portal-arrow" aria-hidden="true">→</span>
            </div>
          </a>

          <a href="/transmisiones" class="portal-row">
            <div class="portal-number">02</div>
            <div class="portal-main">
              <div class="portal-meta">
                <span>CA / 02</span>
                <span>ARCHIVO AUDIOVISUAL</span>
                <span>
                  {String(transmisiones.length).padStart(2, "0")} REGISTROS
                </span>
              </div>
              <h3>Transmisiones</h3>
              <p>
                Videos, monólogos, conversaciones y registros audiovisuales
                producidos por el laboratorio.
              </p>
            </div>
            <div class="portal-action">
              <span>ACCEDER</span>
              <span class="portal-arrow" aria-hidden="true">→</span>
            </div>
          </a>

          <a href="/destilados" class="portal-row">
            <div class="portal-number">03</div>
            <div class="portal-main">
              <div class="portal-meta">
                <span>CA / 03</span>
                <span>ARCHIVO DESTILADO</span>
                <span>{String(totalDestilados).padStart(2, "0")} SÍNTESIS</span>
              </div>
              <h3>Destilados</h3>
              <p>
                Síntesis críticas de libros, artículos y textos fundamentales
                para el análisis del capitalismo contemporáneo.
              </p>
            </div>
            <div class="portal-action">
              <span>EXPLORAR</span>
              <span class="portal-arrow" aria-hidden="true">→</span>
            </div>
          </a>

          <a href="/alicuotas" class="portal-row">
            <div class="portal-number">04</div>
            <div class="portal-main">
              <div class="portal-meta">
                <span>CA / 04</span>
                <span>ARCHIVO EXPERIMENTAL</span>
                <span>{String(totalAlicuotas).padStart(2, "0")} MUESTRAS</span>
              </div>
              <h3>Alícuotas Experimentales</h3>
              <p>
                Fragmentos, intervenciones y muestras textuales donde el
                lenguaje funciona como materia de experimentación crítica.
              </p>
            </div>
            <div class="portal-action">
              <span>EXTRAER</span>
              <span class="portal-arrow" aria-hidden="true">→</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- =====================================================
         AVISOS
    ====================================================== -->
    {
      avisosActivos.length > 0 && (
        <section class="notices-section">
          <div class="container">
            <header class="section-header">
              <div>
                <span class="eyebrow">CA / COMUNICACIÓN</span>
                <h2>Avisos</h2>
              </div>
              <span class="section-count">
                {String(avisosActivos.length).padStart(2, "0")} COMUNICACIÓN
                {avisosActivos.length === 1 ? "" : "ES"}
              </span>
            </header>

            <div class="notices-list">
              {avisosActivos.map((aviso) => (
                <article class="notice-row">
                  <time
                    class="notice-date"
                    datetime={aviso.fecha.toISOString().slice(0, 10)}
                  >
                    {formatShortDate(aviso.fecha)}
                  </time>

                  <div class="notice-main">
                    <span class="notice-label">{aviso.etiqueta}</span>
                    <h3>{aviso.titulo}</h3>
                    <p>{aviso.descripcion}</p>
                  </div>

                  {aviso.href && (
                    <a
                      class="notice-action"
                      href={aviso.href}
                      aria-label={`Abrir aviso: ${aviso.titulo}`}
                    >
                      <span>ESCRIBIR</span>
                      <span class="arrow" aria-hidden="true">→</span>
                    </a>
                  )}
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- =====================================================
         MICELIO (DINÁMICO DESDE src/data/nodos.ts)
    ====================================================== -->
    <section class="mycelium-section" id="micelio">
      <div class="container">
        <header class="section-header">
          <div>
            <span class="eyebrow">ESTRUCTURA DEL LABORATORIO</span>
            <h2>Micelio</h2>
          </div>
          <span class="section-count">
            {String(nodes.length).padStart(2, "0")} NODOS ACTIVOS
          </span>
        </header>

        <div class="mycelium-intro">
          <span class="aside-code">CA / REGISTRO NODAL</span>
          <p>
            Crítica Acelerada se articula como una red de nodos, trayectorias y
            procesos de co-agenciamiento. Las funciones nodales describen el
            estado dentro del micelio, no rangos jerárquicos.
          </p>
        </div>

        <div class="node-grid">
          {
            nodosConTrazas.map(({ node, traceCount }, index) => (
              <a
                href={`/nodos/${node.slug}`}
                class="node-card"
                aria-label={`Abrir perfil nodal de ${node.aliases[0] ?? node.name}`}
              >
                <div class="node-top">
                  <span class="node-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="node-status">{node.status}</span>
                </div>

                <div class="node-meta">
                  <span>{node.code}</span>
                  <span>{node.role}</span>
                </div>

                <h3>{node.aliases[0] ?? node.name}</h3>

                <p class="node-description">
                  {node.fields.slice(0, 4).join(" · ")}.
                </p>

                <div class="node-footer">
                  <span class="node-traces">
                    {String(traceCount).padStart(2, "0")}{" "}
                    {traceCount === 1 ? "TRAZA REGISTRADA" : "TRAZAS REGISTRADAS"}
                  </span>

                  <span class="node-trace">
                    <span>RASTREAR NODO</span>
                    <span class="arrow" aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    background: var(--bg);
    color: var(--text);
    overflow-x: clip;
  }

  /* ============================================================
     HERO EDITORIAL
  ============================================================ */

  .home-hero {
    padding: 2.75rem 0 0;
    border-bottom: 1px solid var(--border);
  }

  .hero-layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
    gap: 2.75rem;
    align-items: center;
    padding-bottom: 2.5rem;
  }

  .hero-meta {
    margin-bottom: 1.5rem;
  }

  .research-fields {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .research-fields span {
    position: relative;
  }

  .research-fields span:not(:last-child)::after {
    content: "·";
    position: absolute;
    right: -0.95rem;
    color: var(--accent-text);
  }

  .hero-title h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(3.35rem, 7.2vw, 6.25rem);
    font-weight: 600;
    line-height: 0.94;
    letter-spacing: -0.035em;
    color: var(--text);
  }

  .hero-title h1 span {
    display: block;
  }

  .hero-title .mission {
    margin-top: 1.85rem;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .hero-visual {
    position: relative;
    aspect-ratio: 1;
    max-width: 440px;
    width: 100%;
    justify-self: end;
    border: 0;
    background: transparent;
    pointer-events: none;
  }

  .hero-art {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.9;
    mix-blend-mode: lighten;
    filter: contrast(1.08) brightness(0.86);
    -webkit-mask-image: radial-gradient(
      ellipse at center,
      #000000 32%,
      rgba(0, 0, 0, 0.85) 54%,
      rgba(0, 0, 0, 0.32) 74%,
      transparent 95%
    );
    mask-image: radial-gradient(
      ellipse at center,
      #000000 32%,
      rgba(0, 0, 0, 0.85) 54%,
      rgba(0, 0, 0, 0.32) 74%,
      transparent 95%
    );
  }

  .visual-fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 58%,
      rgba(0, 0, 0, 0.72) 80%,
      #000000 96%
    );
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2.5rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--border);
  }

  .hero-bottom-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hero-bottom-right {
    text-align: right;
  }

  .hero-bottom-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--accent-text);
  }

  .hero-bottom-detail {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: var(--meta);
    font-variant-numeric: tabular-nums;
  }

  /* ============================================================
     COLUMNA LATERAL DE SECCIÓN
  ============================================================ */

  .section-aside-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }

  .aside-code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--accent-text);
  }

  .aside-index,
  .aside-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    color: var(--meta);
    font-variant-numeric: tabular-nums;
  }

  .aside-rule {
    width: 38px;
    height: 2px;
    margin: 0.35rem 0;
    background: var(--accent);
  }

  /* ============================================================
     PUBLICACIÓN MÁS RECIENTE
  ============================================================ */

  .latest-section {
    padding: 3.5rem 0 4.25rem;
    border-bottom: 1px solid var(--border);
  }

  .latest-inner {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
  }

  .latest-entry {
    padding-top: 1.5rem;
    border-top: 2px solid var(--accent);
  }

  .latest-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    color: var(--meta);
  }

  .latest-code {
    color: var(--accent-text);
    font-weight: 500;
  }

  .latest-author {
    margin-left: auto;
    color: var(--muted);
    text-transform: uppercase;
  }

  .latest-entry h2 {
    margin: 0;
    max-width: 24ch;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4.2vw, 3.35rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--text);
    text-wrap: balance;
  }

  .latest-entry h2 a {
