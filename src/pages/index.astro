
---
import "../styles/global.css";
import SocialFooter from "../components/SocialFooter.astro";
---


<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crítica Acelerada</title>
</head>

<body>

<main class="hero">

    <div class="container">

        <img
            src="/images/logo.png"
            alt="Crítica Acelerada"
            class="logo"
        />

        <p class="eyebrow">
            LABORATORIO DE ESTUDIOS CRÍTICOS SOBRE ACELERACIONISMO, COLAPSO Y RIESGOS EXISTENCIALES
        </p>

        <h1>CRÍTICA ACELERADA</h1>

        <p class="mission">
            Impensar las categorías heredadas para comprender las transformaciones tecnológicas, económicas y filosóficas del presente.
        </p>

    </div>

</main>

<section class="archive portals">

    <div class="container portal-grid">

        <a class="portal-card" href="/expedientes">

            <span class="portal-number">01</span>

            <div class="portal-content">

                <p class="portal-label">
                    ARCHIVO TEXTUAL
                </p>

                <h2>
                    EXPEDIENTES
                </h2>

                <p>
                    Ensayos, investigaciones y documentos críticos sobre
                    aceleracionismo, colapso y riesgos existenciales.
                </p>

                <span class="read-link">
                    Entrar al archivo →
                </span>

            </div>

        </a>

        <a class="portal-card" href="/transmisiones">

            <span class="portal-number">02</span>

            <div class="portal-content">

                <p class="portal-label">
                    ARCHIVO AUDIOVISUAL
                </p>

                <h2>
                    TRANSMISIONES
                </h2>

                <p>
                    Videos, monólogos, conversaciones y registros
                    audiovisuales del laboratorio.
                </p>

                <span class="read-link">
                    Acceder a transmisiones →
                </span>

            </div>

        </a>

    </div>

</section>

<SocialFooter />

</body>

</html>