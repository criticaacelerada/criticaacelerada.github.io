---
import "../../styles/global.css";
import { getCollection } from "astro:content";

const transmisiones = await getCollection("transmisiones");

transmisiones.sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Transmisiones | Crítica Acelerada</title>
</head>

<body>

<main class="article">

<div class="container">

<p class="eyebrow">
TRANSMISIONES
</p>

<h1>
Archivo Audiovisual
</h1>

<p class="mission">
Conversaciones, podcasts y registros audiovisuales del laboratorio.
</p>

<hr />


{
    transmisiones.map((transmision) => (

        <article class="essay">

            <div class="number">
                {String(transmision.data.numero ?? 1).padStart(3,"0")}
            </div>

            <div class="content">

                <h3>
                    {transmision.data.title}
                </h3>

                <p>
                    {transmision.data.description}
                </p>

                <a
                    class="read-link"
                    href={`/transmisiones/${transmision.id}`}
                >
                    Ver transmisión →
                </a>

            </div>

        </article>

    ))
}

</div>

</main>

</body>

</html>