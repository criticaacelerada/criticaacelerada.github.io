---
import "../../styles/global.css";
import HomeButton from "../../components/HomeButton.astro";
import SocialFooter from "../../components/SocialFooter.astro";
import { getCollection } from "astro:content";

const transmisiones = await getCollection("transmisiones");

transmisiones.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Transmisiones | Crítica Acelerada</title>
  </head>

<body>

<SocialFooter />

<HomeButton />

  <main class="transmissions-page">

    <div class="container">

      <section class="transmissions-hero">

        <div class="transmissions-intro">

          <p class="eyebrow">
            TRANSMISIONES
          </p>

          <h1>
            Archivo Audiovisual
          </h1>

          <p class="mission">
            Conversaciones, podcasts y registros audiovisuales del laboratorio.
          </p>

          <div class="transmissions-meta">
            <span>CRÍTICA ACELERADA</span>
            <span>
              {String(transmisiones.length).padStart(2, "0")} TRANSMISIONES
            </span>
          </div>

        </div>

        <div class="transmissions-visual" aria-hidden="true">

          <div class="transmissions-signal">
            <span>C</span>
          </div>

          <img
            src="/images/transmisiones.png"
            alt=""
          />

          <p>
            SEÑAL ABIERTA · ARCHIVO AUDIOVISUAL
          </p>

        </div>

      </section>

      <section class="transmissions-list">

        <div class="transmissions-list-header">
          <span>N.º</span>
          <span>TRANSMISIÓN</span>
          <span>ACCESO</span>
        </div>

        {
          transmisiones.map((transmision) => (

            <article class="transmission-entry">

              <div class="number">
                {String(transmision.data.numero).padStart(3, "0")}
              </div>

              <div class="content">

                <h3>
                  {transmision.data.title}
                </h3>

                <p>
                  {transmision.data.description}
                </p>

              </div>

              <div class="transmission-actions">

                <a
                  class="read-link"
                  href={`/transmisiones/${transmision.id}`}
                >
                  Ver señal →
                </a>

              </div>

            </article>

          ))
        }

      </section>

    </div>

  </main>

</body>

</html>