---
interface Props {
  youtubeId: string;
  title: string;
  context: string;
  label: string;
  expediente: number;
  language: "es" | "en";
  author?: string;
}

const {
  youtubeId,
  title,
  context,
  label,
  expediente,
  language,
  author = "Crítica Acelerada",
} = Astro.props;

const intro =
  language === "en"
    ? "Audiovisual material associated with this dossier."
    : "Material audiovisual asociado a este expediente.";
---

<section class="archivo-audiovisual">

  <div class="archivo-top">
    <span class="archivo-label">
      {label.toUpperCase()} / {String(expediente).padStart(3, "0")}
    </span>
    <span class="archivo-line" aria-hidden="true"></span>
  </div>

  <div class="archivo-grid">
    <div class="archivo-info">
      <p class="archivo-intro">{intro}</p>
      <h2>{title}</h2>
      <p class="archivo-author">{author}</p>
      <p class="archivo-context">{context}</p>
    </div>

    <div class="video-wrapper">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
        title={`${title} — ${author}`}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
  </div>

</section>

<style>
  .archivo-audiovisual {
    margin-top: 4.5rem;
    padding-top: 2rem;
    border-top: 2px solid var(--accent);
  }

  .archivo-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .archivo-label {
    flex-shrink: 0;
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .archivo-line {
    width: 100%;
    height: 1px;
    background: var(--border);
  }

  .archivo-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.35fr);
    gap: 2.5rem;
    align-items: start;
  }

  .archivo-intro {
    margin: 0 0 0.85rem;
    color: var(--meta);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .archivo-info h2 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 3vw, 2.35rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .archivo-author {
    margin: 1.25rem 0 0;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .archivo-context {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .video-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 800px) {
    .archivo-audiovisual {
      margin-top: 3.5rem;
    }

    .archivo-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
