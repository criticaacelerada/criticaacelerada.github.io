---
interface Props {
  handle: string;
  label: string;
  url: string;
}

const { handle, label, url } = Astro.props;
---

<section class="youtube-feed" data-youtube-feed data-handle={handle}>
  <div class="youtube-feed-head">
    <h3>{label}</h3>

    <a
      class="youtube-channel-link"
      href={url}
      target="_blank"
      rel="noopener noreferrer"
    >
      ABRIR CANAL
      <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="youtube-status" data-youtube-status>
    Sincronizando actividad reciente…
  </div>

  <div class="youtube-grid" data-youtube-list hidden></div>
</section>

<script>
  const feeds = document.querySelectorAll("[data-youtube-feed]");

  const formatDate = (value: string | null | undefined) => {
    if (!value) return "";

    return new Intl.DateTimeFormat("es-MX", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
    })
      .format(new Date(value))
      .replaceAll("/", ".");
  };

  for (const feed of feeds) {
    const status = feed.querySelector("[data-youtube-status]");
    const list = feed.querySelector("[data-youtube-list]");

    if (!status || !list) continue;

    fetch("/api/indagando")
      .then((response) => {
        if (!response.ok) {
          throw new Error("YouTube feed error");
        }
        return response.json();
      })
      .then((data) => {
        const videos = Array.isArray(data.videos) ? data.videos : [];

        if (videos.length === 0) {
          status.textContent = "No hay actividad reciente disponible.";
          return;
        }

        for (const video of videos) {
          const item = document.createElement("a");
          item.className = "youtube-card";
          item.href = video.url || "#";
          item.target = "_blank";
          item.rel = "noopener noreferrer";

          const thumb = document.createElement("div");
          thumb.className = "youtube-thumb";

          if (video.thumbnail) {
            const image = document.createElement("img");
            image.src = video.thumbnail;
            image.alt = "";
            image.loading = "lazy";
            thumb.appendChild(image);
          } else {
            thumb.classList.add("youtube-thumb-empty");
            thumb.setAttribute("aria-hidden", "true");
          }

          const copy = document.createElement("div");
          copy.className = "youtube-card-copy";

          const meta = document.createElement("div");
          meta.className = "youtube-card-meta";

          const source = document.createElement("span");
          source.textContent = "YOUTUBE ·";

          const date = document.createElement("time");
          date.textContent = formatDate(video.publishedAt);

          meta.append(source, date);

          const title = document.createElement("h4");
          title.textContent = video.title || "";

          const arrow = document.createElement("span");
          arrow.className = "youtube-card-arrow";
          arrow.setAttribute("aria-hidden", "true");
          arrow.textContent = "↗";

          copy.append(meta, title, arrow);
          item.append(thumb, copy);
          list.appendChild(item);
        }

        status.setAttribute("hidden", "");
        list.removeAttribute("hidden");
      })
      .catch(() => {
        status.textContent =
          "La actividad de INDAGANDO no está disponible temporalmente.";
      });
  }
</script>

<style>
  .youtube-feed {
    margin-top: 2.75rem;
    border-top: 2px solid var(--accent);
  }

  .youtube-feed-head {
    padding: 1.25rem 0 1.1rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .youtube-feed-head h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .youtube-channel-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.4;
    letter-spacing: 0.14em;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    transition: color 0.2s ease;
  }

  .youtube-channel-link span {
    color: var(--accent-text);
  }

  .youtube-channel-link:hover {
    color: var(--text);
  }

  .youtube-status {
    padding: 1.5rem 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    letter-spacing: 0.08em;
    color: var(--meta);
    border-bottom: 1px solid var(--border);
  }

  .youtube-grid {
    width: 100%;
    padding: 1.75rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1.5rem;
  }

  .youtube-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .youtube-card:hover {
    background: var(--surface-hover);
    border-color: var(--accent);
  }

  .youtube-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .youtube-thumb img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.03);
    transition: transform 0.35s ease, filter 0.35s ease;
  }

  .youtube-card:hover .youtube-thumb img {
    transform: scale(1.02);
    filter: saturate(1) contrast(1.04);
  }

  .youtube-thumb-empty {
    background: var(--surface);
  }

  .youtube-card-copy {
    position: relative;
    min-height: 118px;
    padding: 1rem 1.25rem 1.25rem;
  }

  .youtube-card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.4;
    letter-spacing: 0.12em;
    color: var(--meta);
  }

  .youtube-card-meta span {
    color: var(--accent-text);
  }

  .youtube-card h4 {
    margin: 0;
    padding-right: 1.5rem;
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--text);
  }

  .youtube-card-arrow {
    position: absolute;
    right: 1.1rem;
    bottom: 1rem;
    font-size: 0.95rem;
    color: var(--accent-text);
    transition: transform 0.2s ease;
  }

  .youtube-card:hover .youtube-card-arrow {
    transform: translate(3px, -3px);
  }

  @media (max-width: 680px) {
    .youtube-feed-head {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
    }

    .youtube-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .youtube-card-copy {
      min-height: 0;
    }
  }
</style>
