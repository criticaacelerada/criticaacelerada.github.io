---
export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: TocHeading[];
  lang?: "es" | "en";
  variant: "sidebar" | "mobile";
}

const { headings = [], lang = "es", variant } = Astro.props;

const filtered = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
const hasToc = filtered.length >= 2;
const minDepth = hasToc ? Math.min(...filtered.map((h) => h.depth)) : 2;
const label = lang === "en" ? "CONTENTS" : "CONTENIDO";
const toggleLabel =
  lang === "en"
    ? `Table of contents (${filtered.length})`
    : `Índice de secciones (${filtered.length})`;
---

{
  hasToc && variant === "sidebar" && (
    <nav class="toc-sidebar" aria-label={label} data-toc-sidebar>
      <span class="case-sidebar-label">{label}</span>
      <ol class="toc-list">
        {filtered.map((heading) => {
          const level = Math.min(2, heading.depth - minDepth);
          return (
            <li class:list={["toc-item", `toc-level-${level}`]}>
              <a
                class="toc-link"
                href={`#${heading.slug}`}
                data-toc-link={heading.slug}
              >
                {heading.text}
              </a>
            </li>
          );
        })}
      </ol>
    </nav>
  )
}

{
  hasToc && variant === "mobile" && (
    <details class="toc-mobile" data-toc-mobile>
      <summary class="toc-mobile-summary">
        <span class="toc-mobile-title">{toggleLabel}</span>
        <span class="toc-mobile-chevron" aria-hidden="true">+</span>
      </summary>

      <nav class="toc-mobile-body" aria-label={label}>
        <ol class="toc-list">
          {filtered.map((heading) => {
            const level = Math.min(2, heading.depth - minDepth);
            return (
              <li class:list={["toc-item", `toc-level-${level}`]}>
                <a class="toc-link" href={`#${heading.slug}`}>
                  {heading.text}
                </a>
              </li>
            );
          })}
        </ol>
      </nav>
    </details>
  )
}

<script>
  const sidebarNav = document.querySelector("[data-toc-sidebar]");
  if (sidebarNav && !sidebarNav.hasAttribute("data-toc-init")) {
    sidebarNav.setAttribute("data-toc-init", "true");
    const links = Array.from(
      sidebarNav.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
    );
    const targets = links
      .map((link) => {
        const id = link.dataset.tocLink;
        return id ? document.getElementById(id) : null;
      })
      .filter((el): el is HTMLElement => Boolean(el));

    if (targets.length > 0 && "IntersectionObserver" in window) {
      const setActive = (id: string) => {
        for (const link of links) {
          const active = link.dataset.tocLink === id;
          link.classList.toggle("is-active", active);
          if (active) {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

          if (visible[0]?.target.id) {
            setActive(visible[0].target.id);
          }
        },
        {
          rootMargin: "-90px 0px -65% 0px",
          threshold: [0, 1],
        }
      );

      targets.forEach((target) => observer.observe(target));
    }
  }

  const mobileToc = document.querySelector<HTMLDetailsElement>("[data-toc-mobile]");
  if (mobileToc && !mobileToc.hasAttribute("data-toc-init")) {
    mobileToc.setAttribute("data-toc-init", "true");
    mobileToc.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileToc.open = false;
      });
    });
  }
</script>

<style>
  .toc-sidebar {
    margin-top: 1.5rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--border-subtle);
  }

  .toc-list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-height: 40vh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }

  .toc-link {
    display: block;
    padding: 0.35rem 0 0.35rem 0.75rem;
    border-left: 1px solid var(--border-subtle);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.4;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .toc-item.toc-level-1 .toc-link {
    padding-left: 1.25rem;
    font-size: 0.78rem;
  }

  .toc-item.toc-level-2 .toc-link {
    padding-left: 1.65rem;
    font-size: 0.76rem;
    color: var(--meta);
  }

  .toc-link:hover,
  .toc-link.is-active {
    color: var(--text);
    border-left-color: var(--accent);
  }

  .toc-link.is-active {
    color: var(--accent-text);
    border-left-width: 2px;
  }

  /* Acordeón móvil */

  .toc-mobile {
    display: none;
    margin: 0 0 2rem;
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    background: var(--surface);
  }

  .toc-mobile-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 48px;
    padding: 0.75rem 1rem;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text);
  }

  .toc-mobile-summary::-webkit-details-marker {
    display: none;
  }

  .toc-mobile-chevron {
    color: var(--accent-text);
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .toc-mobile[open] .toc-mobile-chevron {
    transform: rotate(45deg);
  }

  .toc-mobile-body {
    padding: 0.25rem 1rem 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .toc-mobile .toc-list {
    max-height: none;
    overflow: visible;
    margin-top: 0.5rem;
    gap: 0.15rem;
  }

  .toc-mobile .toc-link {
    min-height: 40px;
    display: flex;
    align-items: center;
    font-size: 0.88rem;
  }

  @media (max-width: 768px) {
    .toc-sidebar {
      display: none;
    }

    .toc-mobile {
      display: block;
    }
  }
</style>
