---
interface Props {
  citation: string;
  lang?: "es" | "en";
}

const { citation, lang = "es" } = Astro.props;
const defaultLabel = lang === "en" ? "COPY CITATION" : "COPIAR CITA";
const copiedLabel = lang === "en" ? "CITATION COPIED ✓" : "CITA COPIADA ✓";
---

<div class="copy-citation">
  <button
    type="button"
    class="copy-citation-btn"
    data-copy-citation={citation}
    data-label-default={defaultLabel}
    data-label-copied={copiedLabel}
  >
    <svg
      class="copy-citation-icon"
      viewBox="0 0 24 24"
      width="14"
      height="14"
      aria-hidden="true"
    >
      <rect x="9" y="9" width="13" height="13" rx="1"></rect>
      <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
    </svg>
    <span data-copy-citation-text>{defaultLabel}</span>
  </button>
  <span class="sr-only" aria-live="polite" data-copy-citation-live></span>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    "[data-copy-citation]"
  );

  for (const button of buttons) {
    if (button.hasAttribute("data-copy-init")) continue;
    button.setAttribute("data-copy-init", "true");

    const textEl = button.querySelector("[data-copy-citation-text]");
    const liveEl = button
      .closest(".copy-citation")
      ?.querySelector("[data-copy-citation-live]");

    let resetTimer: number | undefined;

    button.addEventListener("click", async () => {
      const citation = button.dataset.copyCitation ?? "";
      const defaultLabel = button.dataset.labelDefault ?? "COPIAR CITA";
      const copiedLabel = button.dataset.labelCopied ?? "CITA COPIADA ✓";

      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(citation);
        } else {
          const area = document.createElement("textarea");
          area.value = citation;
          area.setAttribute("readonly", "");
          area.style.position = "fixed";
          area.style.opacity = "0";
          document.body.appendChild(area);
          area.select();
          document.execCommand("copy");
          document.body.removeChild(area);
        }

        button.classList.add("is-copied");
        if (textEl) textEl.textContent = copiedLabel;
        if (liveEl) liveEl.textContent = copiedLabel;

        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          button.classList.remove("is-copied");
          if (textEl) textEl.textContent = defaultLabel;
          if (liveEl) liveEl.textContent = "";
        }, 2400);
      } catch {
        // Silencioso si el navegador bloquea acceso al portapapeles
      }
    });
  }
</script>

<style>
  .copy-citation {
    margin-top: 1.25rem;
  }

  .copy-citation-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0.5rem 0.9rem;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .copy-citation-btn:hover {
    color: var(--text);
    border-color: var(--accent);
    background: var(--surface-hover);
  }

  .copy-citation-btn.is-copied {
    color: var(--accent-text);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .copy-citation-icon {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
